      Do, (#NumDoorWidthB>7):1
      {
         DisplaySet, #DoorWidth8B =33,          8.  Door Width is Less than or Equal to, DoorWidth.Bmp
         DisplaySet, #DoorCost8B =28.08,                    Cost of a Door   (up to #DoorHeightB" high)   by   (up to #DoorWidth8B" wide), DoorWidthDepth.Bmp
         Set, (#DoorW>#DoorWidth7B)&(#DoorW<=#DoorWidth8B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #CostOfDoor = #DoorCost8B , Set the Cost of This Door
      }
      
      Do, (#NumDoorWidthB>8):1
      {
         DisplaySet, #DoorWidth9B =36,          9.  Door Width is Less than or Equal to, DoorWidth.Bmp
         DisplaySet, #DoorCost9B =29.09,                    Cost of a Door   (up to #DoorHeightB" high)   by   (up to #DoorWidth9B" wide), DoorWidthDepth.Bmp
         Set, (#DoorW>#DoorWidth8B)&(#DoorW<=#DoorWidth9B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #CostOfDoor = #DoorCost9B , Set the Cost of This Door
