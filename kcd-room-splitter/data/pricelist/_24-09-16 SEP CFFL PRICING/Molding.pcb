,KCDw System File. Do NOT Change in any way.
set,#moldremainder=0
set, #measurescale=-
set,(#incm="-inch")&(#moldingscale="inch"):#measurescale=-in
set,(#incm="-inch")&(#moldingscale="foot"):#measurescale=-ft
set,(#incm="-inch")&(#moldingscale="8 foot"):#measurescale=-8 ft Segments
set,(#incm="-Mm")&(#moldingscale="metric"):#measurescale=-Millimeter
set,(#incm="-Cm")&(#moldingscale="metric"):#measurescale=-Centimeter



Do,(#Mld1Cost>0):1
{
   Set,(#moldingscale="inch"):#MoldLength1=[#Mld1Len]
   Set,(#moldingscale="foot"):#MoldLength1=[#Mld1Len/12]
   Set,(#moldingscale="8 foot"):#MoldLength1=[#Mld1Len\96]
   set,(#moldingscale="8 foot"):#moldremainder = [(#Mld1Len/96)-(#Mld1Len\96)]
   set,(#moldingscale="8 foot")&(#moldremainder>0):#moldlength1 = [#moldlength1 + 1]
   Set,(#moldingscale="metric"):#MoldLength1=[#Mld1Len]
   
   Set,#MoldingName1 = <#Mld1Name>
   Set,#MoldingCost1=[#Mld1Cost]
}


