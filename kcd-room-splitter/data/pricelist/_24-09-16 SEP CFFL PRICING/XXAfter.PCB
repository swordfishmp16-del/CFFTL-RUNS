,Set Item Costs by Size Increaments


set,#unitlineal=w
set,#unitsquare=w*h
set,#unitcubic=w*h*d


Load,DoTotals.pcb
PriceOptions, 1, 
,set, (TotOpCst>0):#Subtotal=[#SubTotal+TotOpCst]
,Set,(TotOpCst>0):#Cabtotal = [#Cabtotal+TotOpCst]

Set,(TotOpCst>0):#Cabtotalstd$ = [#Cabtotalstd$ + (TotOpCst*#Number)]
Set,(TotOpCst>0):#Cabtotal = [#Cabtotal + (TotOpCst*#Number*1.#notusedheredesignermarkup)]
Set,(TotOpCst>0):#Subtotalstd$ = [#Subtotalstd$ + (TotOpCst*#Number)]
Set,(TotOpCst>0):#Subtotal = [#Subtotal + (TotOpCst*#Number*1.#notusedheredesignermarkup)]

