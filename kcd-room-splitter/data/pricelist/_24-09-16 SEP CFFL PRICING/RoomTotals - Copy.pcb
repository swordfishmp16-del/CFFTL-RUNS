,Set Item Costs by Size Increaments for 25 Rooms


,Calculating subtotals

Do,(#RoomNum = 1):1
{

Set,#SingleHandlecostKnob=(#UnitDoorKnobCost)
Set,#SingleHandlecostDoor=(#UnitDoorHandleCost)


Set,(#UnitDoorHandleCount>0):#Room1DoorHandleCost = [#Room1DoorHandleCost+(#UnitDoorHandleCost*#UnitDoorHandleCount)]
Set,(#UnitDoorknobCount>0):#Room1DoorKnobCost = [#Room1DoorKnobCost+(#UnitDoorKnobCost*#UnitDoorKnobCount)]
Set,(#UnitDoorHingeCount>0):#Room1DoorHingeCost = [#Room1DoorHingeCost+(#UnitDoorHingeCost*#UnitDoorHingeCount)]


Set,(#SingleHandlecost>0):#DoorKnobRM1Handleprice=[#SingleHandlecost]
Set,#Room1HandleCostsubtotal=[#Room1DoorHandleCost+#Room1DoorKnobCost]
Set,#Room1Counthandle=#UnitDoorHandleCount
Set,#Room1Counthandletot=[#Room1Counthandletot+#Room1Counthandle]
Set,#Room1Countknob=#UnitDoorKnobCount
Set,#Room1Countknobtot=[#Room1Countknobtot+#Room1Countknob]
,Set,#Room1handlePN=#UnitDoorHandlePN
,Set,#Room1knobPN=#UnitDoorKnobPN

load, CFCountoptionsroom1.pcb
set, #room1totalpands= [#Room1panelscost+#Room1shelvescost]

}
,end Room 1

