,Calculates the price for each Cubby part


Set, (#horizontalpricechoice="Fixed Cost"):#W = [(#CubbyWidth-(0.75*(#NumVertCubby-1))) / #NumVertCubby] :#W=#Cubbywidth ,Width of each shelf
Set, #D = [D]
Set, (#panelorshelfcubby="Shelves"):#H = [(#CubbyHeight-(0.75*(#NumHorzCubby-1))) / #NumHorzCubby]:#H = [#CubbyHeight]
Set, (#panelorshelfcubby="Shelves"):#NumH = [(#NumHorzCubby-1)]:#NumH = [(#NumHorzCubby-1)*#NumvertCubby]
Set, (#panelorshelfcubby="Shelves"):#NumV = [(#NumvertCubby-1)*#NumHorzCubby]:#NumV = [(#NumvertCubby-1)]
set, #roomtag= 

set, ((#cubbycostmethod="Hole")|(#Cubbycostmethod="Cost")):#CostOfCubbyUnit =[#CostOfCubbyUnit *#universalupcharge]
Price, (#CubbyCostMethod="Hole"):1,    #CubbyHoleName,        #CostOfCubbyUnit*#NumVertCubby*#NumHorzCubby,    #D,  #H,  #CubbyUnitPrintOrderNumber,  
Price, (#CubbyCostMethod="Cost"):1,    #CubbyHoleName,        #CostOfCubbyUnit,    #D,  #H,  #CubbyUnitPrintOrderNumber,  

Do,(#CubbyCostMethod="Pieces"):1
{
Set,#CostOfCubbyUnit =0.00,    Cost of Each Cubby Hole Unit
set, #shelfwidth=W-LS-RS
set, #shelfdepth=D
load, Pricefixedshelves.pcb

,Calc all Costs for Cubby Verticals
Set, #VertH = [#H]
Set, #VertD = [#D]

set, #temppanelcount=#NumV
Do, (#verticalpricechoice="Panel"):1
{
Load, B-Side Cost.Pcb
Set, #CostOfCubbyVertical = [#CostOfSide]
set, #displaythickness={#sideTH}
set, #roomtag=#DividerName-#displaythickness"-#EdgeBandingType 
}
Do, (#verticalpricechoice="Fixed Cost"):1
{
Set, ((#VertH>#MaxcubbyVheight)|(#VertD>#MaxcubbyVdepth)):#CostOfCubbyVertical = [#CostofcubbyVunit*#oversizeVcubbycharge]:#CostOfCubbyVertical = [#CostofcubbyVunit]
set, #roomtag=RM#roomnum #CubbyVertName-#UnitMaterialName-3/4"-#EdgeBandingType 
set, #CostOfCubbyVertical =[#CostOfCubbyVertical *#universalupcharge]
}


Price, (#NumV>0):1,   #roomtag ,        #CostOfCubbyVertical,    #D,  #H,  #CubbyUnitPrintOrderNumber,         
Price, (#NumV>1):1,   #roomtag ,        #CostOfCubbyVertical,    #D,  #H,  #CubbyUnitPrintOrderNumber,         
