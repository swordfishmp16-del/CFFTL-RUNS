,This was added below to work on xxafter.prt room subtotals
Set,#ClosetHardwaretype=#ExtraUnitText11
set,#unitHWcost=0
set, #tagpricedone=0

,Get base notch if with shoe (Trim off the right defined number chars leaving the Name only)
Do,(#ExtraUnittext9="*shoe*"):1
{
Len, #Size, #ExtraUnitText9
Left,#numberinextraunittextnine, #Size-5, #Extraunittext9
Len, #size, #numberinextraunittextnine
set, #notchdepth=#numberinextraunittextnine
set, #notchheight=#ExtraUnitText10
set, #notchdepthhasshoe=1
}
Do,(#ExtraUnittext9<>"*shoe*"):1
{
set, #notchdepthtemp=#ExtraUnittext9
set, #notchheighttemp=#ExtraUnitText10

set, #notchdepth=#ExtraUnitText9
set,#notchheight=#ExtraUnitText10
set, #notchdepthhasshoe=0

}



load, GetHandleKnobCost.pcb

Load, GetMaterialCostGroup.Pcb

,Check and set edgebandcostfactor on shelves and panels
Load,GetMaterialCostEdgeBanding.pcb

,***Added finish to material
,Check and set Finishing costfactor on shelves and panels
,Load,GetMaterialCostFinishing.pcb

,***Second contrasting material
Load, GetContrastMaterialCostGroup.Pcb


,Check and Set Closet Rod Price
Load,GetMaterialCostRod.pcb

,Check and Set Cost for Base Kick Type and material
Load,GetMaterialCostBaseKick.pcb

