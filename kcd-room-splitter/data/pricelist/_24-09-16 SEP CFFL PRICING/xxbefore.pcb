,Load,GetFlutedPilasterCost.pcb

,Load,GetDrawerBoxCost.pcb


,Load, GetMaterialCostGroup.Pcb


,Build Molding Info
Do, ((I70+I71+I72+I73)>0):1  ,Unit has molding
{
   ,calc Molding length and add to unit count (if wide enough)
   ,set, #MldLen = [(I70*W + I71*(D+6) + I72*(D+6) + I73*(W+6))/12]
set, #MldLen = [(I70*W + I71*(D+6) + I72*(D+6) + I73*(W+6))]
,   set, (W>#SecMinSize): #MldCnt = 1: #MldCnt = 0
,    Set, (w>#Secmaxsize): #MldCnt = [W/#Secmaxsize]

      Set, (W>#secMinSize)&(W<=#secMaxSize)&(T<>550):#Mldcnt=1:#Mldcnt=0
      Set, (W>#secMaxSize)&(T<>550):#MldCnt=[#MldCnt+[W\#secMaxSize]]
      Set, (W>#secMaxSize)&((W/#secMaxSize)-(W\#secMaxSize)>0):#MldCnt=[#MldCnt+1]  
      Set,(#moldingscale<>"Section"):#MldCnt=1  
  
   Do, (#CrownMoldingType = "#CrownMoldingType1"):1
   {
      set, #Mld1Name = <#CrownMoldingType>
      ,set, #Mld1Len = [#Mld1Len + (#MldLen*12)]
      set, #Mld1Len = [#Mld1Len + (#MldLen)]
      set, #Mld1Cnt = [#Mld1Cnt + #MldCnt]
      set, #Mld1Cost = [#Mld1Cost + #CrownMoldingTypeCostGroup]
   }
   Do, (#CrownMoldingType = "#CrownMoldingType2"):1
   {
      set, #Mld2Name = <#CrownMoldingType>
      set, #Mld2Len = [#Mld2Len + (#MldLen)]
      set, #Mld2Cnt = [#Mld2Cnt + #MldCnt]
      set, #Mld2Cost = [#Mld2Cost + #CrownMoldingTypeCostGroup]
   }
   Do, (#CrownMoldingType = "#CrownMoldingType3"):1
   {
      set, #Mld3Name = <#CrownMoldingType>
