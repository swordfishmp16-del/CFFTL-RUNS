,Chelsea was here 10-12-21 - This page will match Room Number, Handle/Knob number, and report the correct handle/knob name.
set, #stophandle=0
Set, #HandleKnobSelection=[#DoorHKN]

Do, (#RoomNum=1):1
 {
   Set, (#HandleKnobSelection=0):#HKName=0
   Set, (#HandleKnobSelection=1.00):#HKName=#HandleName1Room1
   Set, (#HandleKnobSelection=2.00):#HKName=#HandleName2Room1
   Set, (#HandleKnobSelection=3.00):#HKName=#HandleName3Room1
   Set, (#HandleKnobSelection=4.00):#HKName=#HandleName4Room1
   Set, (#HandleKnobSelection=5.00):#HKName=#HandleName5Room1
   Set, (#HandleKnobSelection=6.00):#HKName=#HandleName6Room1
   Set, (#HandleKnobSelection=7.00):#HKName=#HandleName7Room1
   Set, (#HandleKnobSelection=8.00):#HKName=#HandleName8Room1
   Set, (#HandleKnobSelection=9.00):#HKName=#HandleName9Room1
set, #stophandle=1
End
 }

