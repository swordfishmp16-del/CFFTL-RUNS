      Set, (#ShelfWidth>#ShelfLength4B)&(#ShelfWidth<=#ShelfLength5B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost5B , Set the Cost of This Shelf
      }

    Do, (#NumShelfLengthB>5):1
      {
      DisplaySet, #ShelfLength6B =72,          6.  Horizontal Shelf Length is Less than or Equal to, ShelfLength.Bmp
      DisplaySet, #ShelfCost6B =72.12,                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength6B" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength5B)&(#ShelfWidth<=#ShelfLength6B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost6B , Set the Cost of This Shelf
      }

    Do, (#NumShelfLengthB>6):1
      {
