    Do, (#NumShelfLengthB>2):1
      {
      DisplaySet, #ShelfLength3B =96,          3.  Horizontal Shelf Length is Less than or Equal to, ShelfLength.Bmp
      DisplaySet, #ShelfCost3B =(#shelfwidth/32*#ShelfCost1B),                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength3B" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength2B)&(#ShelfWidth<=#ShelfLength3B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost3B , Set the Cost of This Shelf
      Set, (#ShelfWidth>#ShelfLength2B)&(#ShelfWidth<=#ShelfLength3B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #addshelf=14, Shelf count
      }

    Do, (#NumShelfLengthB>3):1
      {
      DisplaySet, #ShelfLength4B =48,          4.  Horizontal Shelf Length is Less than or Equal to, ShelfLength.Bmp
      DisplaySet, #ShelfCost4B =48.12,                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength4B" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength3B)&(#ShelfWidth<=#ShelfLength4B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost4B , Set the Cost of This Shelf
