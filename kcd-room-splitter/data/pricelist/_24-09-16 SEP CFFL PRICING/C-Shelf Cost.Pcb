      DisplaySet, #ShelfCost7B =84.12,                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength7B" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength6B)&(#ShelfWidth<=#ShelfLength7B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost7B , Set the Cost of This Shelf
      }

    Do, (#NumShelfLengthB>7):1
      {
