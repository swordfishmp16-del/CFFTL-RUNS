Set,(ulfl=1)|(fl=1):#KickFinishLeft=1:#KickFinishLeft=0
Set,(urfr=1)|(fr=1):#KickFinishRight=1:#KickFinishRight=0

Set,#unitbaselength=((W+(d*#KickFinishLeft)+(d*#KickFinishRight))/12)

Set,(#BaseTypePricingMethod ="LinFt")&(#BaseType <> "#BaseType1")&(#BaseType <> "#BaseType2"):#CostOfKick =[((W+(d*#KickFinishLeft)+(d*#KickFinishRight))/12)* #BaseTypeCostGroup],        Cost Formula LinFt for a Base
,Was set to this below prior to adding changes for returns above
,Set,(#BaseTypePricingMethod ="LinFt")&(#BaseType <> "#BaseType1")&(#BaseType <> "#BaseType2"):#CostOfKick =[((W)/12)* #BaseTypeCostGroup],        Cost Formula LinFt for a Base

Set,(#BaseTypePricingMethod ="Section"):#CostOfKick =#BaseTypeCostGroup,        Cost Formula for a Base Sections

Set,(#BaseType = "#BaseType1")|(#BaseType = "#BaseType2"):#CostOfKick =#BaseTypeCostGroup,        Cost Formula for a Base Sections





































































