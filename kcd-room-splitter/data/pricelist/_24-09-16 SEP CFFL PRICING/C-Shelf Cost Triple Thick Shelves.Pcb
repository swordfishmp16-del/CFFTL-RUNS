      Set, (#ShelfWidth>0)&(#ShelfWidth<=#ShelfLength1BC) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost1BC ,Set the Cost of This Shelf
      ,Set, (#ShelfWidth>0)&(#ShelfWidth<=#ShelfLength1B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #addShelf = 3 ,Shelf count
