      Set, (#ShelfWidth>#ShelfLength1BC)&(#ShelfWidth<=#ShelfLength2BC) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost2BC , Set the Cost of This Shelf
      ,Set, (#ShelfWidth>#ShelfLength1B)&(#ShelfWidth<=#ShelfLength2B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB):#addShelf = 4 ,Shelf count
      ,**
      }
   

    Do, (#NumShelfLengthB>2):1
      {
      DisplaySet, #ShelfLength3BC =96,            Horizontal Shelf Length is Less than or Equal to, ShelfLength.Bmp
      DisplaySet, #ShelfCost3BC =(#shelfwidth/12*#ShelfCost1BC),                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength3BC" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength2BC)&(#ShelfWidth<=#ShelfLength3BC) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost3BC , Set the Cost of This Shelf
      Set, (#ShelfWidth>#ShelfLength2B)&(#ShelfWidth<=#ShelfLength3B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #addshelf=14, Shelf count
      }

    
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  }


  




  Do,  (#NumShelfDepth>2):1
  {
    DisplaySet, #ShelfDepthC =18, 3 Q...     WHAT IS THE DEPTH OF YOUR 3rd HORIZONTAL SHELF? , ShelfDepth.Bmp
    
