      Set, (#ShelfWidth>#ShelfLength2CC)&(#ShelfWidth<=#ShelfLength3CC) & (#ShelfDepth>#ShelfDepthB)&(#ShelfDepth<=#ShelfDepthC): #CostOfHorizontal = #ShelfCost3CC , Set the Cost of This Shelf
      Set, (#ShelfWidth>#ShelfLength2C)&(#ShelfWidth<=#ShelfLength3C) & (#ShelfDepth>#ShelfDepthB)&(#ShelfDepth<=#ShelfDepthC): #CostOfHorizontal = #addshelf=15, shelf count
      }

    
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  }


 




