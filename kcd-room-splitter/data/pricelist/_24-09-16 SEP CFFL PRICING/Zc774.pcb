,CF Tall 4 opening
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, Pricesides.pcb   
,*****************************************




,********* All VERTICAL DIVIDERS *********
,Top Vertical Divider
Set, #VertH = [DH1]
Set, #VertD = [D]
load, Pricedividers.pcb       
,*****************************************
set, #bottomdrw=3
load, lowerspannercount openings.pcb


,set, (D2T<>3)&(D3T<>3)&(D4T=3):#lowerspannercount=2
,set, (D2T<>3)&(D3T=3)&(D4T<>3):#lowerspannercount=2
,set, (D2T=3)&(D3T<>3)&(D4T<>3):#lowerspannercount=2
,set, (D2T<>3)&(D3T=3)&(D4T=3):#lowerspannercount=1
,set, ((D2T<>3)&(D3T=3)&(D4T=3))&(OPT=#optionLockdr3):#lowerspannercount=2
,set, (D2T=3)&(D3T=3)&(D4T<>3):#lowerspannercount=1
,set, ((D2T=3)&(D3T=3)&(D4T<>3))&(OPT=#optionLockdr2):#lowerspannercount=2
,set, (D2T=3)&(D3T=3)&(D4T=3):#Lowerspannercount=0
,set, ((D2T=3)&(D3T=3)&(D4T=3))&((OPT=#optionLockdr2)|(OPT=#optionLockdr3)):#Lowerspannercount=1
,set, ((D2T=3)&(D3T=3)&(D4T=3))&((OPT=#optionLockdr2)&(OPT=#optionLockdr3)):#Lowerspannercount=2


,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
,set, (LMR>0):#lowerspannercount= 2
load, Pricefixedshelves.pcb     
,*****************************************


,SH2 is always the bottom

,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, (MS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-MS)/2]
Set, (MS=0):#tempshelfcount=SH1:#tempshelfcount=SH1*2
load, Priceadjshelves.pcb

,2nd Adj Shelves
Set, (LMS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-LMS)/2]
Set, (LMS=0):#tempshelfcount=SH3:#tempshelfcount=SH3*2
Load, Priceadjshelves.pcb

,3rd Adj Shelves
Set, (LLMS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-LMS)/2]
Set, (LLMS=0):#tempshelfcount=SH4:#tempshelfcount=SH4*2
Load, Priceadjshelves.pcb

,Lower Adj Shelves
Set, (BMS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-LMS)/2]
Set, (BMS=0):#tempshelfcount=SH2:#tempshelfcount=SH2*2
Load, Priceadjshelves.pcb,   
Set, (#CostOfAdjustableShelf>0)&(opt=#optRWNotchshelfoptnum):#addRWShelfnotch=#Tempshelfcount
Price, (#CostOfAdjustableShelf>0)&(opt=#optRWNotchshelfoptnum):#Tempshelfcount,  #optionRWNotchshelfname cost,  #costtoRWnotchshelves,  , #ShelfWidth,  #AdjustableShelfPrintOrderNumber,

,*****************************************

,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************


,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,     
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************
