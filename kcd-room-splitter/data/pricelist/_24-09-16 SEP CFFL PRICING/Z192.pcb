,CF angled shelf Right and Door 
,Calculates the price for each part

,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, PriceCornersidesangleR.pcb 
,*****************************************



,*********** All SHELVES ***********
Set, #ShelfWidth = [(W-LS)]
Set, #ShelfDepth = [(D-RS)]
load, Pricecornershelves.pcb      
,*****************************************



,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




