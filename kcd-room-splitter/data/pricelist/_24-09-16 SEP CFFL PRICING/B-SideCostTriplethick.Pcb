      DisplaySet, #SideCost7JC =0,                   Cost of a Side #SidethickC thick  (up to #SideDepthJ" deep)   by   (up to #SideHeight7J" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight6J)&(#VertH<=#SideHeight7J) & (#VertD>#SideDepthI)&(#VertD<=#SideDepthJ): #CostOfVertical = #SideCost7JC , Set the Cost of This Side
      }

    Do, (#NumSideHeightJ>7):1
      {
      DisplaySet, #SideCost8JC =0   ,                    Cost of a Side #SidethickC thick  (up to #SideDepthJ" deep)   by   (up to #SideHeight8J" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight7J)&(#VertH<=#SideHeight8J) & (#VertD>#SideDepthI)&(#VertD<=#SideDepthJ): #CostOfVertical = #SideCost8JC , Set the Cost of This Side
      }

    Do, (#NumSideHeightJ>8):1
      {
      DisplaySet, #SideCost9JC =0   ,                    Cost of a Side #SidethickC thick  (up to #SideDepthJ" deep)   by   (up to #SideHeight9J" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight8J)&(#VertH<=#SideHeight9J) & (#VertD>#SideDepthI)&(#VertD<=#SideDepthJ): #CostOfVertical = #SideCost9JC , Set the Cost of This Side
      }

    Do, (#NumSideHeightJ>9):1
      {
      DisplaySet, #SideCost10JC =0  ,                    Cost of a Side #SidethickC thick  (up to #SideDepthJ" deep)   by   (up to #SideHeight10J" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight9J)&(#VertH<=#SideHeight10J) & (#VertD>#SideDepthI)&(#VertD<=#SideDepthJ): #CostOfVertical = #SideCost10JC , Set the Cost of This Side
      }
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

  }


