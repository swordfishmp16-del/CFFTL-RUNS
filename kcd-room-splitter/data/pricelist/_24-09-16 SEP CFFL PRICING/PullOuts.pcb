
,Set PullOut Width
Set, #PullOutWidth = [#PullOutOpeningWidth -1]


,Set Drawer Box Depth
Set, (D < 12):#PullOutDepth = 0
Set, (D >= 12):#PullOutDepth = 10
Set, (D >= 14):#PullOutDepth = 12
Set, (D >= 16):#PullOutDepth = 14
Set, (D >= 18):#PullOutDepth = 16
Set, (D >= 20):#PullOutDepth = 18
Set, (D >= 22):#PullOutDepth = 20
Set, (D >= 24):#PullOutDepth = 22
Set, (D >= 26):#PullOutDepth = 24


,Set PullOut Height
Set, (#PullOutOpeningHeight < 2):#PullOutHeight = 0
Set, (#PullOutOpeningHeight >= 2):#PullOutHeight = 1
Set, (#PullOutOpeningHeight >= 3):#PullOutHeight = 2
Set, (#PullOutOpeningHeight >= 4):#PullOutHeight = 3
Set, (#PullOutOpeningHeight >= 5):#PullOutHeight = 4
