,Set Item Costs by Size Increaments


Load, GetMaterialCostGroup.Pcb
Load, GetShoeFencecost.pcb

,Set,#UsePanelTouchingWallCost=0

,Set,#countloadsforsides=1
,Set,#Totalcountloadsforsides=[#Totalcountloadsforsides+#countloadsforsides]

,Set,(ul=1)&(LS>0)&(#Totalcountloadsforsides=1):#UsePanelTouchingWallCost=#PanelTouchingWallCost

,Set,(#Totalcountloadsforsides=2):#UsePanelTouchingWallCost=0
,Set,(ur=1)&(RS>0)&(#Totalcountloadsforsides=2):#UsePanelTouchingWallCost=#PanelTouchingWallCost

,Change below requested LA CF 7-17-14 Edgeband multiplier
,Set the Cost of Each Type of Shelf
,Set, #CostOfTopShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]
,Set, #CostOfMiddleShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]
,Set, #CostOfBottomShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]
,Set, #CostOfAdjustableShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]
,Set, #CostOfCubbyShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]
,Set, #CostOfShoeShelf = [((#CostOfHorizontal + #CostAddedToShoeShelves)*#MaterialCostGroup)*#EdgeBandCostGroup]

,Change below requested LA CF 8-27-14 Finishing multiplier to work like edgeband
,Set, #CostOfTopShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,Set, #CostOfMiddleShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,Set, #CostOfBottomShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,Set, #CostOfAdjustableShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,Set, #CostOfCubbyShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,Set, #CostOfShoeShelf = [((#CostOfHorizontal + #CostAddedToShoeShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)-#CostOfHorizontal)]
,*******Changed 3/2018 added finish multiplier with material
,Set, #CostOfTopShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,Set, #CostOfMiddleShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,Set, #CostOfBottomShelf = [((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,Set, #CostOfAdjustableShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,Set, #CostOfCubbyShelf = [((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,Set, #CostOfShoeShelf = [((#CostOfHorizontal)*#MaterialCostGroup + #ShoeFenceCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup))+((#CostOfHorizontal*#FinishCostGroup))]
,*****

set, #stopcshelf=0
Do, (#edgebyfoot=yes):1
{
Set, #CostOfTopShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfMiddleShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfBottomShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfAdjustableShelf = [(((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfCubbyShelf = [(((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
,Set, #CostOfShoeShelf = [(((#CostOfHorizontal)*#MaterialCostGroup + #ShoeFenceCostGroup)+(((W/12)*#EdgeBandCostGroup)))*#universalupcharge]
}
Do, (#edgebyfoot=no):1
{
Set, #CostOfTopShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfMiddleShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfBottomShelf = [(((#CostOfHorizontal + #CostAddedToFixedShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfAdjustableShelf = [(((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
Set, #CostOfCubbyShelf = [(((#CostOfHorizontal + #CostAddedToAdjustableShelves)*#MaterialCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
,Set, #CostOfShoeShelf = [(((#CostOfHorizontal)*#MaterialCostGroup + #ShoeFenceCostGroup)+((#CostOfHorizontal*#EdgeBandCostGroup)))*#universalupcharge]
}
set, #stopcshelf=1
,leave file here
End 








