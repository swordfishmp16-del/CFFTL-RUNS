,CF Library Long Hang 96
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
Load, Pricesides.pcb
,*****************************************


,********* All VERTICAL DIVIDERS *********
,Vertical Divider
Set, #VertH = [DH1]
Set, #VertD = [D]
load, Pricedividers.pcb
,*****************************************



,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
set, #lowerspannercount=0
load, Pricefixedshelves.pcb 
,*****************************************




,*********** All ADJ SHELVES *************
,Top Adj Shelves

,*****************************************

,************* Closet Poles ***************
Set, #ShelfWidth = [(W-LS-RS)]
Price, (crodht1>0):1,            #ClosetPoleName,       #ClosetPoleCost,         #ShelfWidth, ,  #ClosetPolePrintOrderNumber,
,Price, (MS>0): 1,           #ClosetPoleName,       #ClosetPoleCost,         #ShelfWidth, ,  #ClosetPolePrintOrderNumber,
Price, (crodht2>0):1,            #ClosetPoleName,       #ClosetPoleCost,         #ShelfWidth, ,  #ClosetPolePrintOrderNumber, 
,Price, (crodht2>0)&(MS>0):1,           #ClosetPoleName,       #ClosetPoleCost,         #ShelfWidth,  ,  #ClosetPolePrintOrderNumber,
,****************************************** 


,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,                     
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
,Load, Doors.pcb
,*****************************************



,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************




