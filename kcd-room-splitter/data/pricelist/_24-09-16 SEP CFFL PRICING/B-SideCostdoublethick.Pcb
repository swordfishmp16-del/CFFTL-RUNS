,Use Grid

,**            ***** DOUBLE THICK SIDES works for LIST method only for 6 depths only *****
,**


Set, #CostOfVertical = 0, Default Cost





 
  Do,  (#NumSideDepth>0):1
  {
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
   
    Do, (#NumSideHeightA>0):1
      {
      DisplaySet, #SideCost1AB =218*#panelpricemultiplier,                   Cost of a Side #SidethickB thick  (up to #SideDepthA" deep)   by   (up to #SideHeight1A" high), SideHeightDepth.Bmp
      Set, (#VertH>0)&(#VertH<=#SideHeight1A) & (#VertD>0)&(#VertD<=#SideDepthA): #CostOfVertical = #SideCost1AB ,Set the Cost of This Side
      Set, (#VertH>0)&(#VertH<=#SideHeight1A) & (#VertD>0)&(#VertD<=#SideDepthA): #addpanel = 1 ,panel count
      }

    Do, (#NumSideHeightA>1):1
      {   
      DisplaySet, #SideCost2AB =264*#panelpricemultiplier,                   Cost of a Side  #SidethickB thick (up to #SideDepthA" deep)   by   (up to #SideHeight2A" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight1A)&(#VertH<=#SideHeight2A) & (#VertD>0)&(#VertD<=#SideDepthA): #CostOfVertical = #SideCost2AB , Set the Cost of This Side
      Set, (#VertH>#SideHeight1A)&(#VertH<=#SideHeight2A) & (#VertD>0)&(#VertD<=#SideDepthA): #addpanel=2, panel count
      }

    Do, (#NumSideHeightA>2):1
      {
      DisplaySet, #SideCost3AB =344*#panelpricemultiplier,                   Cost of a Side  #SidethickB thick (up to #SideDepthA" deep)   by   (up to #SideHeight3A" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight2A)&(#VertH<=#SideHeight3A) & (#VertD>0)&(#VertD<=#SideDepthA): #CostOfVertical = #SideCost3AB , Set the Cost of This Side
      Set, (#VertH>#SideHeight2A)&(#VertH<=#SideHeight3A) & (#VertD>0)&(#VertD<=#SideDepthA):#addpanel=3, panel count
      }

    Do, (#NumSideHeightA>3):1
      {
      DisplaySet, #SideCost4AB =413*#panelpricemultiplier,                   Cost of a Side #SidethickB thick  (up to #SideDepthA" deep)   by   (up to #SideHeight4A" high), SideHeightDepth.Bmp
