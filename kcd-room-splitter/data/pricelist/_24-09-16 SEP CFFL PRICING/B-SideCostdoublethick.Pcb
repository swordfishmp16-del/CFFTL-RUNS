      Set, (#VertH>#SideHeight3A)&(#VertH<=#SideHeight4A) & (#VertD>0)&(#VertD<=#SideDepthA): #addpanel=4, panelcount
      }

    Do, (#NumSideHeightA>4):1
      {
      DisplaySet, #SideCost5AB =60.11,                   Cost of a Side  #SidethickB thick (up to #SideDepthA" deep)   by   (up to #SideHeight5A" high), SideHeightDepth.Bmp
      Set, (#VertH>#SideHeight4A)&(#VertH<=#SideHeight5A) & (#VertD>0)&(#VertD<=#SideDepthA): #CostOfVertical = #SideCost5AB , Set the Cost of This Side
      }

