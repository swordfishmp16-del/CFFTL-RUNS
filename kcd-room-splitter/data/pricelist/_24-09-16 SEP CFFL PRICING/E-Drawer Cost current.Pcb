,valid drawer
Do, ((#CostofDrawer<>100)):1
{
,Update V8.0 start
 Price, (#swapglides=1):1, RM#Roomnum Switch Glides to Side Mount Charge, #swapglidescharge, ,  , #DoorPrintOrderNumber, 
,Update V8.0 end
,Below used in Subtotal Calculations

Set,#UnitDrawerCost=[#UnitDrawerCost+#CostOfDrawer]
Set,#UnitDrawerNum=[#UnitDrawerNum+1]
,update v7.2.2 start

Set, #costofdrawer=[#costofdrawer]
,update v7.2.2 end
,Update V7.2.6 start
,get special edgeband door upcharges
set, (#DoorDrawerFinishingType="*Front*"):#Drawerfaceupcharge=((#DrawerFrontWidth*#DrawerFrontHeight)/144*#DoorDrawerFinishingCostGroup)
set, ((#DoorDrawerFinishingType<>"*Front*")&(#DoorDrawerFinishingType="*mm*")):#Drawerfaceupcharge=((#CostOfDrawer)*(#DoorDrawerFinishingCostGroup))
,Price Drawer Box
Set, #H = {#H} 
Price, (#DoorDrawerType="#DoorDrawerTypeName1")&((#DoorDrawerFinishingType="*mm*")&(#DoorDrawerFinishingType<>"*2nd*")):1, Add to DrFrt-#DoorDrawerFinishingType, #Drawerfaceupcharge, #DrawerFrontHeight, #DrawerFrontWidth , #DoorPrintOrderNumber, 
Price, (#DoorDrawerType="#DoorDrawerTypeName2")&((#DoorDrawerFinishingType="*mm*")&(#DoorDrawerFinishingType<>"*Front*")):1, Add to DrFrt-#DoorDrawerFinishingType, #Drawerfaceupcharge, #DrawerFrontHeight, #DrawerFrontWidth , #DoorPrintOrderNumber, 
Price, 1,    #DrawerBoxName-#H"-#BoxDrawertype,      #CostOfDrawer,     #D, #W,  #DrawerBoxPrintOrderNumber,  
}
,Update V7.2.6 end
,***Cost for pullout shelf
DisplaySet, #Pulloutshelfupcharge =70,     -----------------    Cost for Pullout Shelf  -UPCHARGE-
, Update V8.0 start
Do, ((#CostofDrawer=100)&(#H<3))|((#H<4)&(opt=#optDrw1boxtoshelf)&(#drawernumber=1)):1
,Update V8.0 end
{

Set, #ShelfWidth = [(W-LS-RS)-1]     
Set, #ShelfDepth = [#D]
Set, #H = {#H}
Load, C-Shelf Cost.Pcb
set, #Tempshelfcount=1
load, Countshelves.pcb
Price, 1,    Drawer Box to Shelf-#H"-#unitmaterialname,      #CostOfAdjustableShelf+#Pulloutshelfupcharge,     #ShelfDepth, #ShelfWidth,  #DrawerBoxPrintOrderNumber, 

} 

,drawer too big
Do, ((#CostofDrawer=100)&(#laundry=0)&(#H>4)):1
{
set, #name = Invalid Drawer Size
load, Eachunit.pcb
} 

,drawer converted to laundry door
,Do, ((#CostofDrawer=100)&(#laundry=1)&(#H>26)&(#DoorDrawerType="#DoorDrawerTypeName1")):1
,{
,set, #CostOfDrawer=#48orLessDoorCost*#DoorDrawerTypeCostFactor1
,Price ,1         ,Changed to door - #Doordrawertype - #unitmaterialname, #CostOfDrawer,    #DoorW-(#Gap/2), #DoorH, #DrawerBoxPrintOrderNumber,
,set, #laundry=0
}

,Remove These
Erase, #W
Erase, #H
Erase, #D 



