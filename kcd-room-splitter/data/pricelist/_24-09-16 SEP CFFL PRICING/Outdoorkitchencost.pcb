set, #stopOKcost=0

,******* All DOORS & DRAWER FRONTS *******
Load, OKDoors.pcb
,*****************************************
set, #Note =#Memodoor #DoorDrawerFinishingType

set, #stopOKcost=1

set, #hingeside=L
Do, (#unitfilename="*SD*"):1
{
set, (D1HG=2): #hingeside=R:#hingeside=L
}
Do, (#unitfilename="*side*"):1
{
set, (D2HG=2): #hingeside=R:#hingeside=L
}


set, #Widthcode=W
set, (D>27):#depthcode=D:#depthcode=
set, #partsize=#Widthcode#depthcode#HingeSide


Do,(#UnitLibrary="*Outdoor*"):1
 {
  ReadCSVFile,Outdoor Kitchen Costs.csv,1,2,3,4,5
  ReadCsvValue,Outdoor Kitchen Costs.csv,#Name,#tagcodeL,#tagcodeR,#TemptotalunitCost,#haslegs
 }
 

set, (#hingeside="L"):#okPartnumber=#tagcodeL:#okPartnumber=#tagcodeR


Set, #TotalUnitCost=[#TempTotalUnitCost*#universalupcharge]
Price,1, RM#roomnum #Name #OKPartnumber ,#TotalUnitCost, w, d, h 

set, (#haslegs="Yes"):#legchoice=#ExtraUnitText15
set, (#legchoice="Black"):#legPN=WS-PLASTIC-LEGS:#legPN=STAINLESS-LEGS-4PK


  ,Once the cutlist has made it to the bottom for the first time this is here to prevent TagCounterFile from resetting itself to all 0s again & the header won't print for every single TAG item.
 Set, #FirstokTimeHere=1

,   We will be collecting names of objects on job, a qty, and a cost for the "row" based on the drawing to report as a CSV table.



,Do, (#ExcludePoleItem=1):1
, {
,  SendToFile, #OKDestinationPath\#CSVName Outdoor Kitchen Order List.CSV,#Name#Comma#Code#Comma#Width#Comma#Length#Comma#Depth#Comma1#Comma$#TotalUnitCost
  ,
  ,Set,#OutdoorTotal=[#TotalUnitCost+#TagHardwareTotal]
  
  
, }


,Chelsea was here 9-13-21 - Step 2 - Collect - Take in totals/running the meter when "Pole" exclusion is not present.
,Do, (#ExcludePoleItem=0):1
, {
 , Set, #QuantityLoop=1

  ,Chelsea was here 11-12-21 - Clipped the "While" structure from !! KCD Frame
  ,  Loop the "Collect" for NUM times - a single unit is 1, a unit with quantity 9 would run 9 times.
 , While, (#QuantityLoop<=NUM)

     , Load, CommonOKCounter_Collect.pcb

   , set,#QuantityLoop=[#QuantityLoop+1]
    ,Set,#TagHardwareTotal=<#TotalUnitCost+#TagHardwareTotal>
    ,Loops through until #QuantityLoop is greater than NUM or Quantity on the object from the design screen.
  ,Wend

, }


load, xxafterpriceok.pcb


set, #stopOKcost=2

end


