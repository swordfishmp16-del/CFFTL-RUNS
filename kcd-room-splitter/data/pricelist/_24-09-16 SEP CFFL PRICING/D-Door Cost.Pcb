,*********************************************************************************************************
,** Specialty Door pricing
Displayset,#FramedDrawerFrontCost=145*#MaterialCostGroup*#universalupcharge, Cost of Framed drawer front (add insert)
Displayset,#Appliedmirrorcostdoor=60*#DoorArea, Cost of Applied Mirror (added to Flat Edgeband door)
Displayset,#Appliedmirrorcostdwr=60*#DoorArea, Cost of Applied Mirror (added to Flat Edgeband Drawer)


Displayset,#ClearAcrylicDoorcost=40*#DoorArea, Cost factor of Clear Acrylic Door 
Displayset,#MatteAcrylicDoorcost=40*#DoorArea, Cost factor of Matte Acrylic Door
Displayset,#SmokeAcrylicdoorcost=55*#DoorArea, Cost factor of Smoke Acrylic Door
Displayset,#solidglassdoorcost=65*#doorarea,Cost Factor for Solid Glass Door
Displayset,#solidfrostedglassdoorcost=75*#doorarea,  Cost Factor for Solid Frosted Glass Door
Displayset,#metalframedoorcost=75*#doorarea,  Cost Factor for Metal Frame Door
Displayset,#StyliteAcrylicMirrordoorcost=50*#doorarea, Cost for Stylite Acrylic Mirror Door Cost

,****
Displayset, #DefaultWallBeddoorcost=473*#MaterialCostGroup,Cost of your Twin wallbed single door matching material
,********************************************************************************************************

,**
,**Set up for Melamine style doors different material from panels/shelves
**These doors are priced by size.
DisplaySet,#DoorDrawerTypeName2=Melamine 2nd Material,         Door Drawer Type 2 Name
DisplaySet,#DoorDrawerTypeCostFactor2=1, 1.2   #DoorDrawerTypeName2 Door Drawer Type Cost Factor
DisplaySet,#Doorheight2ndcount=2,Q...     HOW MANY DIFFERENT Door Heights DO YOU USE?  [1;2;3]
  Do, (#Doorheight2ndcount >0):1
  {
   DisplaySet, #Doorheight2ndA =48,Q1...     WHAT IS THE smallest door Height ? (Shortest), 
   Displayset, #Appliedmolding2ndA=88, Cost of Applied Molding on #Doorheight2ndA #DoorDrawerTypeName2 Door
   DisplaySet, #Doorwidth2ndcount=2,Q1.1...     HOW MANY DIFFERENT Widths DO YOU USE FOR THIS door?  [1;2;3;4;5]
    Do, (#Doorwidth2ndcount>0):1
    {
    DisplaySet, #Doorwidth2nd1A =36.625,         1.1.1 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost2nd1A =160*#ContrastMaterialCostGroup,                   Cost of a door (up to #Doorheight2ndA" tall)   by   (up to #DoorWidth2nd1A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName2")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth2nd1A) & (#DoorH>0)&(#DoorH<=#DoorHeight2ndA): #Tempdoorcost = #DoorCost2nd1A ,Set the Cost of This Door
