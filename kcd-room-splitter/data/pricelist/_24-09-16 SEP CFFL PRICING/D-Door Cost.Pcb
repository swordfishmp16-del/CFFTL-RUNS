    ,Update v7.2.9 start
    Set,  ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth1C)&(#DoorW<=#Doorwidth2C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Basicdoorcost = #DoorCost2C ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#DoorwidthcountC>2):1
    {
    DisplaySet, #Doorwidth3C =41,          3.1.3 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost3C =190*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightC" tall)   by   (up to #DoorWidth3C" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2C)&(#DoorW<=#Doorwidth3C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Tempdoorcost = #DoorCost3C ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2C)&(#DoorW<=#Doorwidth3C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Addmoldingtodoor=#AppliedmoldingC
    ,Update v7.2.9 start
    Set,  ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth2C)&(#DoorW<=#Doorwidth3C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Basicdoorcost = #DoorCost3C ,Set the Cost of This Door
