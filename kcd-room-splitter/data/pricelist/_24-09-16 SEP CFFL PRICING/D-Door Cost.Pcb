Set, #Basicdoorcost=[#basicdoorcost*#universalupcharge]
,**
DisplaySet,#DoorheightFramecount=2,Q...     HOW MANY DIFFERENT FRAMED Door Heights DO YOU USE?  [1;2;3]
  Do, (#DoorheightFramecount >0):1
  {
