,Use Grid


,**
,***************************************************  DOOR AND DRAWER COST SETUP  *****************************************************************
,**
,Update V7.2.9 start
DisplaySet,#PriceMethodDoors =Square Foot,         --------   PRICING METHOD FOR DOORS & DRAWER FRONTS - (By Square Foot)-(Fixed Cost) [Basic Plus;Square Foot;Fixed Cost]
,Update V7.2.9 end
,**
,{
DisplaySet,#NoChargeDrawerFront=1, Set to zero for No charge on Drawer Fronts or 1 if you want to charge
,**

,Set, #DoorArea = [#DoorA/144]
,Update V7.2.9 start
,Set, (#Endpanel=0): #DoorArea = (#DoorH*#DoorW)/144:#DoorArea=(#EndpanelH*#EndpanelW)/144
,Update V7.2.9 end
Set,  #DoorArea = (#DoorH*#DoorW)/144

,Update 7.2.1 Start
Displayset, #DrFrtfactor=1, Q------- Is there a different charge for custom drawer faces? (*1.00=no >1.00=multiplier higher <1.00=multiplier lower) or +fixed charge)
,Update 7.2.1 End 
Displayset, #showincludedsdrawerfaceonreport=No, Q----Do you want to show 0 charge Drawer Faces on the pricing report? [Yes;No]
,
,CHANGED HEREDisplaySet,#GlassDoorExtraCost=0, Extra Cost for Glass?
, Setting the insert cost
,Update V7.2.12 start
DisplaySet,#GlassDoorExtraCost=#DoorArea*#DoorDrawerInsertCostGroup, Extra Cost for Selected Door Insert?
,Update V8.0 start
,**Speaker cloth, 1/4 melamine, Mirror, beveled mirror,and smoke acrylic set in AA-User.
Set,#SpeakerDoorExtraCost=#DoorArea*#DoorDrawerInsertCostSpeaker, Extra Cost for Speaker Door Insert?
Set,#MirrorDoorExtraCost=#DoorArea*#DoorDrawerInsertCostMirror, Extra Cost for Mirror Door Insert?
Set,#BevelMirrorDoorExtraCost=#DoorArea*#DoorDrawerInsertCostBevmirror, Extra Cost for Bevel Mirror Door Insert?
Set,#14melamineDoorExtraCost=#DoorArea*#DoorDrawerInsertCost14Mel, Extra Cost for 1/4 Melamine Door Insert?
Set,#SmokeDoorExtraCost=#DoorArea*#DoorDrawerInsertCostSmoke, Extra Cost for Smoke Acrylic Door Insert?
Set,#FrostedDoorExtraCost=#DoorArea*#DoorDrawerInsertCostFrost, Extra Cost for Frosted Glass Door Insert?
Set,#EtchedDoorExtraCost=#DoorArea*#DoorDrawerInsertCostEtched, Extra Cost for Etched Glass Door Insert?
,update V8.0end

,Update V7.2.12 end
,**
,CHANGED HERESet,#PriceDoorsSqFT=(#DoorArea  *  (#DoorDrawerStyleCostGroup+#DoorDrawerFinishingCostGroup+#DoorDrawerInsertCostGroup))
Set,(#DoorDrawerType="*RTF*"):#PriceDoorsSqFT=(#DoorArea*(#DoorDrawerStyleCostGroup*#DoorDrawerFinishingCostGroup)):#PriceDoorsSqFT=(#DoorArea*(#DoorDrawerStyleCostGroup+#DoorDrawerFinishingCostGroup))
Set,#PriceDoorsFixed=(#DoorDrawerStyleCostGroup)
,Update V7.2.9 start
Set,(#DoorDrawerType="*RTF*"):#PriceDoorsbasicplus=(#basicdoorcost+(#DoorArea*(#DoorDrawerStyleCostGroup*#DoorDrawerFinishingCostGroup))):#PriceDoorsbasicplus=(#basicdoorcost+(#DoorArea*(#DoorDrawerStyleCostGroup+#DoorDrawerFinishingCostGroup)))
,Update V7.2.9 end

,**
,Update 7.2.3 start - removed above 7.2.2 location and relocated it here.
Load,GetDoorStyleCost.pcb
,Update 7.2.3 end

,**
Set,(#PriceMethodDoors="Square Foot"):#PricingDoors=(#PriceDoorsSqFT)
Set,(#PriceMethodDoors="Fixed Cost"):#PricingDoors=(#PriceDoorsFixed)
,Update V7.2.9 start
Set,(#PriceMethodDoors="Basic Plus"):#PricingDoors=(#PriceDoorsbasicplus)

,Set,(#PriceMethodDoors="Square Foot"):#PricingDoors=(#PriceDoorsSqFT)
,Set,(#PriceMethodDoors="Fixed Cost"):#PricingDoors=(#PriceDoorsFixed)
,Update V7.2.9 end

,**update 7.2.1 copy from here to where noted below and replace in franchise D-Door Cost.pcb file Door Drawer Type 1 and Door Drawer Type 2 setup
,**
,** Hinge Costs
Displayset, #Standarddoorhingecost=0, Cost for Standard door Hinges per hinge
Displayset, #Overlaydoorhingecost=0, Cost for Overlay door Hinges per hinge
Displayset, #tipoutdoorhingecost=0, Cost for Tip-out door Hinges per hinge
Displayset, #Liftupdoorhingecost=25, Cost for Lift-up door Hinges per hinge
Displayset, #LUHNote=Lift Up Hinge, Note for Lift-up Hinge
,Displayset, #Insetdoorhingecost=10, Cost for Inset door Hinges per hinge

,Displayset, #Liftupdoorhingecost=55, Cost for Lift-up door Hinges per door
set, #Addmoldingtodoor=0, set default
,**
,Update V7.2.9 start
set, #basicdoorcost=0
,Update V7.2.9 end

set, #Tempdoorcost=0
,**   Door and Drawer Type
,** 
,**Set up for Melamine style doors same color as panels/shelves
,**These doors are priced by size.
DisplaySet,#DoorDrawerTypeName1=Melamine,         Door Drawer Type 1 Name
DisplaySet,#DoorDrawerTypeCostFactor1=1, 1.1    #DoorDrawerTypeName1 Door Drawer Type Cost Factor
DisplaySet,#Doorheightcount=2,Q...     HOW MANY DIFFERENT Door Heights DO YOU USE?  [1;2;3]
  Do, (#Doorheightcount >0):1
  {
   DisplaySet, #DoorheightA =48,Q1...     WHAT IS THE smallest door Height ? (Shortest)
   Displayset, #AppliedmoldingA=95, Cost of Applied Molding on #DoorheightA #DoorDrawerTypeName1 Door
   DisplaySet, #Doorwidthcount=2,Q1.1...     HOW MANY DIFFERENT Widths DO YOU USE FOR THIS door?  [1;2;3;4;5]
    Do, (#Doorwidthcount>0):1
    {
    DisplaySet, #Doorwidth1A =38,         1.1.1 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost1A =160*#MaterialCostGroup,                   Cost of a door (up to #DoorheightA" tall)   by   (up to #DoorWidth1A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Tempdoorcost = #DoorCost1A ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Addmoldingtodoor = #AppliedmoldingA 
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>0)&(#DoorW<=#Doorwidth1A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #basicdoorcost = #DoorCost1A ,Set the Cost of basic door
    ,Update v7.2.9 end
    }
    Do, (#Doorwidthcount>1):1
    {
    DisplaySet, #Doorwidth2A =40,         1.1.2 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost2A =237*#MaterialCostGroup,                   Cost of a door (up to #DoorheightA" tall)   by   (up to #DoorWidth2A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth1A)&(#DoorW<=#Doorwidth2A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Tempdoorcost = #DoorCost2A ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth1A)&(#DoorW<=#Doorwidth2A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Addmoldingtodoor = #AppliedmoldingA 
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth1A)&(#DoorW<=#Doorwidth2A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Basicdoorcost = #DoorCost2A ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#Doorwidthcount>2):1
    {
    DisplaySet, #Doorwidth3A =48.625,          1.1.3 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost3A =145*#MaterialCostGroup,                   Cost of a door (up to #DoorheightA" tall)   by   (up to #DoorWidth3A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2A)&(#DoorW<=#Doorwidth3A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Tempdoorcost = #DoorCost3A ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2A)&(#DoorW<=#Doorwidth3A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Addmoldingtodoor = #AppliedmoldingA
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth2A)&(#DoorW<=#Doorwidth3A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #basicdoorcost = #DoorCost3A ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#Doorwidthcount>3):1
    {
    DisplaySet, #Doorwidth4A =36,          1.1.4 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost4A =120*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightA" tall)   by   (up to #DoorWidth4A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth3A)&(#DoorW<=#Doorwidth4A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Tempdoorcost = #DoorCost4A ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth3A)&(#DoorW<=#Doorwidth4A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Addmoldingtodoor = #AppliedmoldingA
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth3A)&(#DoorW<=#Doorwidth4A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Basicdoorcost = #DoorCost4A ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#Doorwidthcount>4):1
    {
    DisplaySet, #Doorwidth5A =36,          1.1.5 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost5A =120*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightA" tall)   by   (up to #DoorWidth5A" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth4A)&(#DoorW<=#Doorwidth5A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Tempdoorcost = #DoorCost5A ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth4A)&(#DoorW<=#Doorwidth5A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #Addmoldingtodoor = #AppliedmoldingA
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth4A)&(#DoorW<=#Doorwidth5A) & (#DoorH>0)&(#DoorH<=#DoorHeightA): #basicdoorcost = #DoorCost5A ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
  }
  Do, (#Doorheightcount >1):1
  {
   DisplaySet, #DoorheightB =96,Q2...     WHAT IS THE 2nd smallest door Height ? (next tallest), 
   Displayset, #AppliedmoldingB=170, Cost of Applied Molding on #DoorheightB #DoorDrawerTypeName1 Door
   DisplaySet, #DoorwidthcountB=1,Q2.1...     HOW MANY DIFFERENT Widths DO YOU USE FOR THIS door?  [1;2;3;4;5]
    Do, (#DoorwidthcountB>0):1
    {
    DisplaySet, #Doorwidth1B =42,          2.1.1 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost1B =237*#MaterialCostGroup,                   Cost of a door (up to #DoorheightB" tall)   by   (up to #DoorWidth1B" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Tempdoorcost = #DoorCost1B ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Addmoldingtodoor=#AppliedmoldingB
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>0)&(#DoorW<=#Doorwidth1B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #basicdoorcost = #DoorCost1B ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#DoorwidthcountB>1):1
    {
    DisplaySet, #Doorwidth2B =36.625,          2.1.2 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost2B =145*1.25*#MaterialCostGroup,                   Cost of a door (up to #DoorheightB" tall)   by   (up to #DoorWidth2B" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth1B)&(#DoorW<=#Doorwidth2B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Tempdoorcost = #DoorCost2B ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth1B)&(#DoorW<=#Doorwidth2B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Addmoldingtodoor=#AppliedmoldingB
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth1B)&(#DoorW<=#Doorwidth2B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #basicdoorcost = #DoorCost2B ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#DoorwidthcountB>2):1
    {
    DisplaySet, #Doorwidth3B =43,          2.1.3 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost3B =145*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightB" tall)   by   (up to #DoorWidth3B" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2B)&(#DoorW<=#Doorwidth3B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Tempdoorcost = #DoorCost3B ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth2B)&(#DoorW<=#Doorwidth3B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Addmoldingtodoor=#AppliedmoldingB
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth2B)&(#DoorW<=#Doorwidth3B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #basicdoorcost = #DoorCost3B ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#DoorwidthcountB>3):1
    {
    DisplaySet, #Doorwidth4B =36,          2.1.4 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost4B =120*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightB" tall)   by   (up to #DoorWidth4B" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth3B)&(#DoorW<=#Doorwidth4B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Tempdoorcost = #DoorCost4B ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth3B)&(#DoorW<=#Doorwidth4B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Addmoldingtodoor=#AppliedmoldingB
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth3B)&(#DoorW<=#Doorwidth4B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Basicdoorcost = #DoorCost4B ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
    Do, (#DoorwidthcountB>4):1
    {
    DisplaySet, #Doorwidth5B =36,          2.1.5 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost5B =120*1.5*#MaterialCostGroup,                   Cost of a door (up to #DoorheightB" tall)   by   (up to #DoorWidth5B" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth4B)&(#DoorW<=#Doorwidth5B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Tempdoorcost = #DoorCost5B ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>#Doorwidth4B)&(#DoorW<=#Doorwidth5B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Addmoldingtodoor=#AppliedmoldingB
    ,Update v7.2.9 start
    Set, ((#doorT<>3)|((#doorT=3)&(#HasHinges=1)))&(#DoorW>#Doorwidth4B)&(#DoorW<=#Doorwidth5B) & (#DoorH>#DoorHeightA)&(#DoorH<=#DoorHeightB): #Basicdoorcost = #DoorCost5B ,Set the Cost of This Door
    ,Update v7.2.9 end
    }
  }
  Do, (#Doorheightcount >2):1
  {
   DisplaySet, #DoorheightC =96,Q3...     WHAT IS THE 3rd  door Height ? (next tallest), 
   Displayset, #AppliedmoldingC=150, Cost of Applied Molding on #DoorheightC #DoorDrawerTypeName1 Door
   DisplaySet, #DoorwidthcountC=2,Q3.1...     HOW MANY DIFFERENT Widths DO YOU USE FOR THIS door?  [1;2;3;4;5]
    Do, (#DoorwidthcountC>0):1
    {
    DisplaySet, #Doorwidth1C =18.625,          3.1.1 Door width is Less than or Equal to, 
    DisplaySet, #DoorCost1C =190*#MaterialCostGroup,                   Cost of a door (up to #DoorheightC" tall)   by   (up to #DoorWidth1C" wide), 
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Tempdoorcost = #DoorCost1C ,Set the Cost of This Door
    Set, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#Includeinsert=0)&(#DoorW>0)&(#DoorW<=#Doorwidth1C) & (#DoorH>#DoorHeightB)&(#DoorH<=#DoorHeightC): #Addmoldingtodoor=#AppliedmoldingC
    ,Update v7.2.9 start
