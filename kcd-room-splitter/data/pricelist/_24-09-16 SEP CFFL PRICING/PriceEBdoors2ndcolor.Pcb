
      ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
Do, (#IncludeInsert=0):1
{
      Set,(#DoorH<=#EBDoorHeightA)&(#DoorW<=#EBDoorWidth1A):#Costofdoor= #SmEB2ndDoorCost                 
      Set,(#DoorH<=#EBDoorHeightA)&((#DoorW>#EBDoorWidth1A)&(#DoorW<=#EBDoorWidth2A)):#Costofdoor= #SmEB2ndDoorCostw
      Set,(#DoorH<=#EBDoorHeightA)&((#DoorW>#EBDoorWidth2A)&(#DoorW<=#EBDoorWidth3A)):#Costofdoor= #SmEB2ndDoorCostxw

      Set,((#DoorH>#EBDoorHeightA)&(#DoorH<=#EBDoorHeightB))&(#DoorW<=#EBDoorWidth1B):#Costofdoor= #MedEB2ndDoorCost                 
      Set,((#DoorH>#EBDoorHeightA)&(#DoorH<=#EBDoorHeightB))&((#DoorW>#EBDoorWidth1B)&(#DoorW<=#EBDoorWidth2B)):#Costofdoor= #MedEB2ndDoorCostw
      ,Set,((#DoorH>#EBDoorHeightA)&(#DoorH<=#EBDoorHeightB))&((#DoorW>#EBDoorWidth2B)&(#DoorW<=#EBDoorWidth3B)):#Costofdoor= #MedEB2ndDoorCostxw
    

      ,Set,((#DoorH>#EBDoorHeightB)&(#DoorH<=#EBDoorHeightC))&(#DoorW<=#EBDoorWidth1C):#Costofdoor= #LrgEB2ndDoorCost                 
      ,Set,((#DoorH>#EBDoorHeightB)&(#DoorH<=#EBDoorHeightC))&((#DoorW>#EBDoorWidth1C)&(#DoorW<=#EBDoorWidth2C)):#Costofdoor= #LrgEB2ndDoorCostw
      ,Set,((#DoorH>#EBDoorHeightB)&(#DoorH<=#EBDoorHeightC))&((#DoorW>#EBDoorWidth2C)&(#DoorW<=#EBDoorWidth3C)):#Costofdoor= #LrgEB2ndDoorCostxw
}     



Do, (#IncludeInsert=1):1
{
      Set,(#DoorH<=#FEBDoorHeightA)&(#DoorW<=#FEBDoorWidth1A):#Costofdoor= #SmFEB2ndDoorCost                 
      ,Set,(#DoorH<=#FEBDoorHeightA)&((#DoorW>#FEBDoorWidth1A)&(#DoorW<=#FEBDoorWidth2A)):#Costofdoor= #SmFEB2ndDoorCostw
      ,Set,(#DoorH<=#FEBDoorHeightA)&((#DoorW>#FEBDoorWidth2A)&(#DoorW<=#FEBDoorWidth3A)):#Costofdoor= #SmFEB2ndDoorCostxw

      Set,((#DoorH>#FEBDoorHeightA)&(#DoorH<=#FEBDoorHeightB))&(#DoorW<=#FEBDoorWidth1B):#Costofdoor= #MedFEB2ndDoorCost                 
      Set,((#DoorH>#FEBDoorHeightA)&(#DoorH<=#FEBDoorHeightB))&((#DoorW>#FEBDoorWidth1B)&(#DoorW<=#FEBDoorWidth2B)):#Costofdoor= #MedFEB2ndDoorCostw
      ,Set,((#DoorH>#FEBDoorHeightA)&(#DoorH<=#FEBDoorHeightB))&((#DoorW>#FEBDoorWidth2B)&(#DoorW<=#FEBDoorWidth3B)):#Costofdoor= #MedFEB2ndDoorCostxw
      
      ,Set,((#DoorH>#FEBDoorHeightB)&(#DoorH<=#FEBDoorHeightC))&(#DoorW<=#FEBDoorWidth1C):#Costofdoor= #LrgEBDoorCost                 
      ,Set,((#DoorH>#FEBDoorHeightB)&(#DoorH<=#FEBDoorHeightC))&((#DoorW>#FEBDoorWidth1C)&(#DoorW<=#FEBDoorWidth2C)):#Costofdoor= #LrgFEB2ndDoorCostw
      ,Set,((#DoorH>#FEBDoorHeightB)&(#DoorH<=#FEBDoorHeightC))&((#DoorW>#FEBDoorWidth2C)&(#DoorW<=#FEBDoorWidth3C)):#Costofdoor= #LrgFEB2ndDoorCostxw
}     


