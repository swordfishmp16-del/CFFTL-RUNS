,Chelsea was here 10-12-21 - This page will match Room Number, Handle/Knob number, and report the correct handle/knob name.



set, #HWCount=#newHWcount
set, #HWcost=(#TempHKtotalunitCost*#HWCount)

Do, (#RoomNum=1):1
 {
Set,(#codedoor="*extruded*"):#extrudedHandlesRoom1=1

   Do, ("#HKName"=0):1
   {
   set,#CodeHandleName0Room1=999
   set,#CountHandleName0Room1=[#CountHandleName0Room1+#HWCount]
   set,#CostHandleName0Room1=0
   }
  Do, (#HKName="#HandleName1Room1"):1
   {
   set,#CodeHandleName1Room1=<#HKCode>
   set,#CountHandleName1Room1=[#CountHandleName1Room1+#HWCount]
   set,#CostHandleName1Room1=[#CostHandleName1Room1+#HWcost]
   }
Do,(#HandleName2Room1<>"#HandleName1Room1"):1
{
set,#handlecountstop=1
  Do, (#HKName="#HandleName2Room1"):1
   {
   set,#CodeHandleName2Room1=<#HKCode>
   set,#CountHandleName2Room1=[#CountHandleName2Room1+#HWCount]
   set,#CostHandleName2Room1=[#CostHandleName2Room1+#HWcost]
   }
set,#handlecountstop=2

}
