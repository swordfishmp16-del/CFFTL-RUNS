,Use Grid


,**
,**
,** SET COSTS FOR Garage Base platform with legs
,** 
,**
set, #setplatformcost=0
DisplaySet,#gbmethod=0, Do you price garage leg bases per piece=0 or per section=1? [0;1]
Do ,(#gbmethod=1):1
{
  Displayset,#GBsectionsize=37.5, Section size for pricing levelers by unit width
  Displayset, #GBmaxsize=96, Max length for pricing platform unit length

}
Do ,(#gbmethod=0):1
{
Displayset,#setplatformcost=1, Do you price the platform shelf using standard shelf cost=0 or set ft/2 price=1? [0;1]
  Displayset, #GBmaxsize=95, Max length for pricing platform unit length
  Do, (#setplatformcost=1):1
  {
  Displayset,#garageplatformsqftprice=12*#Materialcostgroup, 1.0 What is the cost/ft2 for garage base platform?
  }
}
,** COSTS FOR base legs 
DisplaySet,#Garageleg1Name =Standard, 1.1 Name of Garage Leg
DisplaySet,#Garageleg1cost =6, 1.1  Cost for #Garageleg1Name per leg or per section
DisplaySet,#Garageleg1PN =stock, 1.1  Part Number for #Garageleg1Name 
,**

DisplaySet,#Garageleg2Name =Brushed Chrome, 1.2  Name of Garage Leg
DisplaySet,#Garageleg2cost =17, 1.2 Cost for #Garageleg2Name per leg or per section
DisplaySet,#Garageleg2PN =Rich 5010161210, 1.2  Part Number for #Garageleg2Name
,**
DisplaySet,#Garageleg3Name =Black Aluminum, 1.3  Name of Garage Leg
DisplaySet,#Garageleg3cost =17, 1.3  Cost for #Garageleg3Name per leg or per section
DisplaySet,#Garageleg3PN =RIch 50101612900, 1.3  Part Number for #Garageleg3Name
,**
DisplaySet,#Garageleg4Name =Stainless, 1.4  Name of Garage Leg
DisplaySet,#Garageleg4cost =41, 1.4  Cost for #Garageleg4Name per leg or per section
DisplaySet,#Garageleg4PN =550100170, 1.4  Part Number for #Garageleg4Name
,**

DisplaySet,#Garageleg5Name =Square BRCH, 1.5  Name of Garage Leg
DisplaySet,#Garageleg5cost =19, 1.5  Cost for #Garageleg5Name per leg or per section
DisplaySet,#Garageleg5PN =634.16.421, 1.5  Part Number for #Garageleg5Name
,**

