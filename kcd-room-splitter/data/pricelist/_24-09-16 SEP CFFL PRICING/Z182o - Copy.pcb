,Upper 45 shelf Right with no Door
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [LCCD]
Load, B-Side Cost.Pcb
Price, (LS>0):1,   #LeftSideName,         #CostOfSide,             #VertD, #VertH,          #LeftSidePrintOrderNumber,          

Set, #VertD =  [(D-RS)]
Load, B-Side Cost.Pcb
Price, (#Use3rdBack=Yes):1,   #BackSideName,         #CostOfSide,             #VertD, #VertH,          #LeftSidePrintOrderNumber,          

Set, #VertD = [RCCD]
Load, B-Side Cost.Pcb
Price, (RS>0):1,   #RightSideName,        #CostOfSide,             #VertD, #VertH,          #RightSidePrintOrderNumber,         
,*****************************************




,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS)]
Set, #ShelfDepth = [(D-RS)]
Load, C-Shelf Cost.Pcb
Price, (TR>0):1,     #TopShelfName,         #CostOfTopShelf+ #ShelfCostLS,         #ShelfDepth, #ShelfWidth,  #TopShelfPrintOrderNumber,          
Price, (BR>0):1,     #BottomShelfName,      #CostOfBottomShelf+ #ShelfCostLS,      #ShelfDepth, #ShelfWidth,  #BottomShelfPrintOrderNumber,       
,*****************************************




,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, #ShelfWidth = [(W-LS)]
Set, #ShelfDepth = [(D-RS)]

Load, C-Shelf Cost.Pcb
Price, SH,          #AdjustableShelfName,  #CostOfAdjustableShelf+ #ShelfCostLS,  #ShelfDepth, #ShelfWidth,  #AdjustableShelfPrintOrderNumber,   
,*****************************************




,************* OTHER PARTS ***************
,***Backing on 1 side     Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,             #ShelfWidth, h,          #BackPrintOrderNumber,              
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,             #ShelfWidth, h,          #BackPrintOrderNumber,              
,Price, 1,            #ClosetPoleName,       #ClosetPoleCost,         (W-LS-RS), 1,  #ClosetPolePrintOrderNumber,        
,***one kick per unit  Price, (K>0):1,    #KickName,               #CostOfKick,             #ShelfWidth+3, K,        #KickPrintOrderNumber,              
,Price, (K>0):1,    #KickName,               #CostOfKick,             #ShelfDepth+3, K,        #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************



,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************


