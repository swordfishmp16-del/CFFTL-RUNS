



,set, #thicknessoutput=[#thicknessmm]
,set, #widthoutput = [#widthsum]
,set, #lengthoutput = [#lengthsum]

,6THFACE OPERATION NOTES 
,#6thfacenote

,WALL Number
,#Wallname

,ROOM NAME
,#Roomname

,PART NOTE
,#Note

,EDGEBAND color and thickness
,#EdgeBandName

