set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight)&(#UnitFileName="*tipout*")&(#hafelepartnumber="Direct Entry"):#tipouthamperbraketpartnumber =#Basket10TOBracketPN
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight)&(#UnitFileName="*tipout*"):#plasticliner=#Basket10TOplastic
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight)&(#UnitFileName="*tipout*"):#clothliner=#Basket10TOcanvas
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight)&(#UnitFileName="*tipout*"):#plasticlinercost=#Basket10TOplasticcost
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight)&(#UnitFileName="*tipout*"):#clothlinercost=#Basket10TOcanvascost
