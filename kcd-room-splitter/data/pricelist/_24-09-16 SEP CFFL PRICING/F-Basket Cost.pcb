Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight):  #CostOfBasket=[#BasketCost]
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight):#typeofbasket=#Basket2type
,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

}



