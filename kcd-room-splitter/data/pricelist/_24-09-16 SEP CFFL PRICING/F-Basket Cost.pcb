Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight):#plasticliner=#Basket10plastic
Set, (#W=#BasketWidth) & (#D>=#Basket1Depth) & (#H=#BasketHeight):#clothliner=#Basket10canvas

