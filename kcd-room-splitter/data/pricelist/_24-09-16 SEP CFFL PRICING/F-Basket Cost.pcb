,V7.2.4 end of editing (see note at start)

Do, (#hafelepartnumber="Hafele"):1
{

Set, (#Basketfinish="CHR"):#basketfinishcode=2
Set, (#Basketfinish="MB"):#basketfinishcode=3
Set, (#Basketfinish="WHT"):#basketfinishcode=7
Set, (#Basketfinish="SG"):#basketfinishcode=5
Set, (#Basketfinish="MG"):#basketfinishcode=8
Set, (#Basketfinish="MNL"):#basketfinishcode=6

Set, (#Basketfinish="CHR"):#bracketfinishcode=990
Set, (#Basketfinish="MB"):#bracketfinishcode=390
Set, (#Basketfinish="WHT"):#bracketfinishcode=991
Set, (#Basketfinish="SG"):#bracketfinishcode=590
Set, (#Basketfinish="MG"):#bracketfinishcode=890
Set, (#Basketfinish="MNL"):#bracketfinishcode=690

Set, (#w =30): #basketwidthcode=41
Set, (#w =24): #basketwidthcode=40
Set, (#w =18): #basketwidthcode=38
Set, (#w =24)&(#UnitFileName="*tipout*"):#basketTOwidthcode=2
Set, (#w =18)&(#UnitFileName="*tipout*"):#basketTOwidthcode=1

Set, (#d >=16):#basketdepthcode=5
Set, (#d >=14)&(#d <16):#basketdepthcode=3
Set, (#d >=12)&(#d <14):#basketdepthcode=1
Set, (#d >=16)&(#UnitFileName="*tipout*"):#basketTOdepthcode=4
Set, (#d >=14)&(#d <16)&(#UnitFileName="*tipout*"):#basketTOdepthcode=3

set, (#h =17):#BasketHeightcode=8
set, (#h =11):#BasketHeightcode=6
set, (#h =6):#BasketHeightcode=2
Set, (#h =17)&(#UnitFileName="*tipout*"):#basketTOheightcode=42


Set,(#basketdepthcode=0):#Typeofbasket=Invalid Size

Do, (#basketfinishcode=5):1 ,Slate invalid sizes
 {
set, #stopbasket=1
 Set,(#basketdepthcode=1):#TypeofBasket=Invalid Size
 Set,(#basketdepthcode=5):#TypeofBasket=Invalid Size
set, #stopbasket=2
 }
Do, (#basketfinishcode=6):1 ,Matte Nickel invalid sizes
 {
 Set,(#basketdepthcode=1):#TypeofBasket=Invalid Size
 }
Do, (#basketfinishcode=3):1 ,MB invalid sizes
 {
 Set,(#basketdepthcode=1):#TypeofBasket=Invalid Size
 }
Do, (#basketfinishcode=7):1 ,White invalid sizes
 {
 Set,(#basketdepthcode=1)&(#basketHeightcode=2)&(#basketWidthcode=38):#TypeofBasket=Invalid Size
