DisplaySet, #BasketHeight =17,     -----------------     Height of Basket         - HEIGHT -
DisplaySet, #BasketCost =195,     -----------------     Cost of Basket             - COST -
Displayset, #Basket10type=8572414140  RICH 24/17,  -----------------     Description of Basket or PN for Direct Entry    - TYPE -
Displayset, #24intipoutcost=115,-----------------     Cost for Tip Out HAMPER Laundry Version
Set, (#UnitFileName="*tipout*"):#BasketCost =#24intipoutcost
Displayset,  #Basket10TOBasketPN=Tip Out Hamper 547.42.242,  -----------------     Direct Entry Part number of Tip Out HAMPER Basket  
Displayset,  #Basket10TOBracketPN=-547.42.990,  -----------------     Direct Entry Part number of Tip Out HAMPER Bracket 
Displayset, #Basket10TOplastic=-Hamper 547.95.434,  -----------------     Description of Tip Out HAMPER Basket Plastic Liner    
Displayset, #Basket10TOcanvas=-Hamper 547.42.488,  -----------------     Description of Tip Out HAMPER Basket Cloth Liner  
Displayset, #Basket10TOplasticcost=15,  -----------------     Cost of Tip Out HAMPER Basket Plastic Liner    
Displayset, #Basket10TOcanvascost=40,  -----------------     Cost of Tip Out HAMPER Basket Cloth Liner   

Displayset, #Basket10plastic=-547.98.463,  -----------------     Description of Basket Plastic Liner 
Displayset, #Basket10canvas=-547.36.489,  -----------------     Description of Basket Cloth Liner 
