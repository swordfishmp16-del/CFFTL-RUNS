,Set, #CostOfSide =  [(#CostOfVertical + #CostAddedToSides)]

,Set the Cost of Each Type of Shelf
,Set, #CostOfTopShelf = [(#CostOfHorizontal + #CostAddedToFixedShelves)]
,Set, #CostOfMiddleShelf = [(#CostOfHorizontal + #CostAddedToFixedShelves)]
