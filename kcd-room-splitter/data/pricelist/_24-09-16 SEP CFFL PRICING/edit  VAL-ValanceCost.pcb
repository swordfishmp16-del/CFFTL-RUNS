,
,Use Grid
,Set Item Costs factor for Valences 

,**

,Calculating subtotals


displayset, #Valancesize1a=30, 1.1a Premade valance size length1a
displayset, #Valancesize1b=36, 1.1b Premade valance size length1b
displayset, #ValanceCost1=75*#ValanceFinishCost, 1.2 Cost for Premade valance size length1
,
displayset, #Valancesize2a=42, 1.3a Premade valance size length2a
displayset, #Valancesize2b=48, 1.3b Premade valance size length2b
displayset, #ValanceCost2=100*#ValanceFinishCost, 1.4 Cost for Premade valance size length2
,
displayset, #customsizevalancecharge=125*#ValanceFinishCost,  1.5 Charge for custom sized valance
displayset, #customdesignvalance=150*#ValanceFinishCost, 1.6 Charge for custom valance design

Set,(W=#Valancesize1a)|(W=#Valancesize1b):#ValanceCostGroup=#ValanceCost1
Set,(W=#Valancesize2a)|(W=#Valancesize2b):#ValanceCostGroup=#ValanceCost2
,Update V7.2.7 start
Set,((W<>#Valancesize2a)&(W<>#Valancesize2b)&(W<>#Valancesize1a)&(W<>#Valancesize1b)):#ValanceCostGroup=#customsizevalancecharge
,Update V7.2.7 end

Set,(#DoorDrawerFinishingType = "#DoorDrawerFinishingType1"):#ValanceFinishName ="#unitmaterialname"
displaySet,#valancefinishcost1=#materialcostgroup, 2.1 Percent Upcharge Cost for valance finish #DoorDrawerFinishingType1
Set,(#DoorDrawerFinishingType = "#DoorDrawerFinishingType1"):#ValanceFinishCost = #valancefinishcost1, 

