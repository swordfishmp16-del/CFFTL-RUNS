Set, (#wallbeddepthtrack=1)&(#ContrastMaterialName<>"None")&(#DoorW>#Maxdoorwidth): #TempDoorCost=#DefaultWallBeddoor2ndcost

Set, #CFSpecialDoors=0
Set,(#Codedoor="StyliteAcrylicMirror")|(#Codedoor="ST-Glass")|(#Codedoor="Clear Acrylic")|(#Codedoor="Matte Acrylic")|(#Codedoor="flatCFMirror")|(#Codedoor="flatcfmolding")|(#Codedoor="Smoke Acrylic")|(#Codedoor="Glass")|(#Codedoor="FrostedGlass"):#CFSpecialDoors=1

Do,(#CFSpecialDoors=1):1
{
,mirrored doors all sizes matching melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName="None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Appliedmirrorcostdoor)*#DoorDrawerTypeCostFactor1 , flatCFMirror door 
,applied molding doors all sizes matching melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatcfmolding")&(#ContrastMaterialName="None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Addmoldingtodoor)*#DoorDrawerTypeCostFactor1 , Applied Molding door 

,mirrored doors all sizes 2nd color melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName<>"None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Appliedmirrorcostdoor)*#DoorDrawerTypeCostFactor2 , flatCFMirror door 
Set,(#Codedoor="flatCFMirror")&(#Tempdoorcost=0):#CostofDoor=0
,applied molding doors all sizes 2nd color melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatcfmolding")&(#ContrastMaterialName<>"None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Addmoldingtodoor)*#DoorDrawerTypeCostFactor2 , applied molding door 
Set,(#Codedoor="flatcfmolding")&(#Tempdoorcost=0):#CostofDoor=0

,Acrylic doors
Set,(#Codedoor="Clear Acrylic"):#CostOfDoor=(#ClearAcrylicdoorcost*#universalupcharge), clear acrylic door
Set,(#Codedoor="Matte Acrylic"):#CostOfDoor=(#MatteAcrylicdoorcost*#universalupcharge), Matte acrylic door
Set,(#Codedoor="Smoke Acrylic"):#CostOfDoor=(#SmokeAcrylicdoorcost*#universalupcharge), Smoke acrylic door
,Solid Glass Doors
Set,(#Codedoor="Glass"):#CostOfDoor=(#Solidglassdoorcost*#universalupcharge), Solid door
Set,(#Codedoor="FrostedGlass"):#CostOfDoor=(#SolidFrostedGlassdoorcost*#universalupcharge), Solid Frosted Glass door
,Metal framed door
Set,(#Codedoor="ST-Glass"):#CostOfDoor=((#MetalFramedoorcost+#GlassDoorExtraCost)*#universalupcharge), Metal Frame Glass door
Set,(#Codedoor="StyliteAcrylicMirror"):#CostOfDoor=(#StyliteAcrylicMirrordoorcost*#universalupcharge), Stylite acrylic Mirror door


Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&((#Codedoor="*Acrylic*")|(#Codedoor="FrostedGlass")|(#Codedoor="Glass")):1 ,RM#Roomnum #Codedoor Door,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber 
Price,(#CostOfDoor>0)&(#IncludeInsert=1)&(#CFSpecialdoors=1)&((#Codedoor="ST-Glass")):1 ,RM#Roomnum Metal Door-#DoorDrawerInsertType,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName="None"):1 , RM#Roomnum #Codedoor Door-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber, 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName<>"None"): 1 , RM#Roomnum #Codedoor Door-#ContrastMaterialName-#contrastMaterialCostGroup-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatcfMolding")&(#ContrastMaterialName="None"):1 , RM#Roomnum #Codedoor Door-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber, 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatcfMolding")&(#ContrastMaterialName<>"None"): 1 , RM#Roomnum #Codedoor Door-#ContrastMaterialName-#contrastMaterialCostGroup-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,

Set,  (#DoorLD>0): #UnitDoorCost = [[#UnitDoorCost] + [#CostOfDoor]]
Set,  (#DoorLD>0): #TotalNumDoors = [#TotalNumDoors + 1]

