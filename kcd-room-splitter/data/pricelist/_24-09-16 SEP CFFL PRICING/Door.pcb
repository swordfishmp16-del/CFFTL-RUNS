,This calculates the cost of each Door and Drawer Front
Set, #Gap = DrGp
load, Doorset.pcb
,load, D-Door Cost.pcb
Set, #CostOfDoor=0 ,Set as Default
,set, #includeinsert=0
,Set,(#UseDoorCode=Yes):#DoorName=#CodeDoor:#DoorName=Door - #MemoDoor
,Set,(#UseDoorCode=Yes):#DrFrtName=#CodeDoor:#DrFrtName=DrFrt - #MemoDoor

,Set,(#UseDoorCode=Yes):#DoorName=#CodeDoor:#DoorName=Door - #DoorDrawerType
Set,(#endpanel=1):#DoorName=Door End Panel-#DoorDrawerType:#DoorName=Door-#DoorDrawerType
,Set,(#UseDoorCode=Yes):#DrFrtName=#CodeDoor:#DrFrtName=DrFrt-#DoorDrawerType
Set,#DrFrtName=DrFrt-#DoorDrawerType
Set, ((#DoorDrawerFinishingCostGroup<1)):#edgebanddoorspecialfinishcost=(1+#DoorDrawerFinishingCostGroup):#edgebanddoorspecialfinishcost=1
Set, ((#DoorDrawerFinishingType="*mm*")):#edgebandfinish=-#DoorDrawerFinishingType:#edgebandfinish=-#EdgeBandingType
Set, ((#DoorDrawerFinishingType="*Front*")):#edgebandfinish=
Set, ((#DoorDrawerFinishingType="*Front*")|(#DoorDrawerFinishingType="*mm*")):#dredgebandfinish=:#dredgebandfinish=-#EdgeBandingType

set, (#DoorDrawerFinishingType="*Front*"):#Doorfaceupcharge=((#Doorw*#DoorH)/144*#DoorDrawerFinishingCostGroup)

set, #drawerstop=99

,Single Door
Set,  (#DoorSD>0): #ThisDoor = #DoorSD                                      ,SINGLE DOOR
set, #whichdoor=Single
Do, (#DoorSD>0):1
{
Load, (#DoorSD>0): DoorSet.Pcb
Load, (#DoorSD>0): DoorHandleKnob.Pcb
Load, (#DoorSD>0): Glassdr.Pcb

Set, (#wallbeddepthtrack=1)&(#ContrastMaterialName="None")&(#TempDoorCost=0): #TempDoorCost=#DefaultWallBeddoorcost
Set, (#wallbeddepthtrack=1)&(#ContrastMaterialName<>"None")&(#TempDoorCost=0): #TempDoorCost=#DefaultWallBeddoor2ndcost

Set, #CFSpecialDoors=0
Set,(#Codedoor="StyliteAcrylicMirror")|(#Codedoor="ST-Glass")|(#Codedoor="Clear Acrylic")|(#Codedoor="Matte Acrylic")|(#Codedoor="flatCFMirror")|(#Codedoor="flatcfmolding")|(#Codedoor="Smoke Acrylic")|(#Codedoor="Glass")|(#Codedoor="FrostedGlass"):#CFSpecialDoors=1

Do,(#CFSpecialDoors=1):1
{
,mirrored doors all sizes matching melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName="None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Appliedmirrorcostdoor)*#DoorDrawerTypeCostFactor1 , flatCFMirror door 
,applied molding doors all sizes matching melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatcfmolding")&(#ContrastMaterialName="None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Addmoldingtodoor)*#DoorDrawerTypeCostFactor1 , Applied Molding door 

,mirrored doors all sizes 2nd color melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName<>"None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Appliedmirrorcostdoor)*#DoorDrawerTypeCostFactor2 , flatCFMirror door 
Set,(#Codedoor="flatCFMirror")&(#Tempdoorcost=0):#CostofDoor=0
,applied molding doors all sizes 2nd color melamine
Set,(#IncludeInsert=0)&(#Codedoor="flatcfmolding")&(#ContrastMaterialName<>"None"):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#Addmoldingtodoor)*#DoorDrawerTypeCostFactor2 , applied molding door 
Set,(#Codedoor="flatcfmolding")&(#Tempdoorcost=0):#CostofDoor=0

,Acrylic doors
Set,(#Codedoor="Clear Acrylic"):#CostOfDoor=(#ClearAcrylicdoorcost*#universalupcharge), clear acrylic door
Set,(#Codedoor="Matte Acrylic"):#CostOfDoor=(#MatteAcrylicdoorcost*#universalupcharge), Matte acrylic door
Set,(#Codedoor="Smoke Acrylic"):#CostOfDoor=(#SmokeAcrylicdoorcost*#universalupcharge), Smoke acrylic door
,Solid Glass Doors
Set,(#Codedoor="Glass"):#CostOfDoor=(#Solidglassdoorcost*#universalupcharge), Solid door
Set,(#Codedoor="FrostedGlass"):#CostOfDoor=(#SolidFrostedGlassdoorcost*#universalupcharge), Solid Frosted Glass door
,Metal framed door
Set,(#Codedoor="ST-Glass"):#CostOfDoor=((#MetalFramedoorcost+#GlassDoorExtraCost)*#universalupcharge), Metal Frame Glass door
Set,(#Codedoor="StyliteAcrylicMirror"):#CostOfDoor=(#StyliteAcrylicMirrordoorcost*#universalupcharge), Stylite acrylic Mirror door


Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&((#Codedoor="*Acrylic*")|(#Codedoor="FrostedGlass")|(#Codedoor="Glass")):1 , RM#Roomnum #Codedoor Door,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber 
Price,(#CostOfDoor>0)&(#IncludeInsert=1)&(#CFSpecialdoors=1)&((#Codedoor="ST-Glass")):1 ,RM#Roomnum Metal Door-#DoorDrawerInsertType,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName="None"):1 ,RM#Roomnum #Codedoor Door-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber, 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatCFMirror")&(#ContrastMaterialName<>"None"): 1 ,RM#Roomnum #Codedoor Door-#ContrastMaterialName-#ContrastMaterialCostGroup-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatcfMolding")&(#ContrastMaterialName="None"):1 ,RM#Roomnum #Codedoor Door-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber, 
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=1)&(#Codedoor="flatcfMolding")&(#ContrastMaterialName<>"None"): 1 ,RM#Roomnum #Codedoor Door-#ContrastMaterialName-#ContrastMaterialCostGroup-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,

Set,  (#DoorSD>0): #UnitDoorCost = [[#UnitDoorCost] + [#CostOfDoor]]
Set,  (#DoorSD>0): #TotalNumDoors = [#TotalNumDoors + 1]

}

Do, (#DoorDrawerType = "#DoorDrawerTypeName1")&(#CFSpecialdoors=0):1              ,flat edgeband door cost
{
,Edgeband doors allowed sizes matching melamine
Set,(#IncludeInsert=0):#CostOfDoor=(#TempDoorCost*#edgebanddoorspecialfinishcost)*#DoorDrawerTypeCostFactor1 ,  flat door 

,Framed doors allowed sizes matching melamine
Set,(#IncludeInsert=1)&(#Tempdoorcost>0):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#GlassDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Solid")|(#Codedoor="flat-HG-Solid")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#14melamineDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Solid")|(#Codedoor="flat-HG-Solid")):#DoorDrawerInsertType=#DoorDrawerInsert14Mel
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Speaker")|(#Codedoor="flat-HG-Speaker")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#SpeakerDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Speaker")|(#Codedoor="flat-HG-Speaker")):#DoorDrawerInsertType=#DoorDrawerInsertSpeaker
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Smoke")|(#Codedoor="flat-HG-Smoke")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#SmokeDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Smoke")|(#Codedoor="flat-HG-Smoke")):#DoorDrawerInsertType=#DoorDrawerInsertSmoke
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Mirror")|(#Codedoor="flat-HG-Mirror")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#MirrorDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Mirror")|(#Codedoor="flat-HG-Mirror")):#DoorDrawerInsertType=#DoorDrawerInsertMirror
Set,(#IncludeInsert=1)&(#Tempdoorcost=0):#CostofDoor=0

Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#wallbeddepthtrack=1)&(#chargeallwbdoors=Yes):1 ,#DoorName-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,   
Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#wallbeddepthtrack=0):1 ,#DoorName-#UnitMaterialName-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,   
Price,(#CostOfDoor>0)&(#IncludeInsert=1)&(#wallbeddepthtrack=0):1 ,Framed #DoorName-#UnitMaterialName-#DoorDrawerInsertType#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,
Price, (#DoorDrawerFinishingType="*front*"):1, Add to Door-#DoorDrawerFinishingType, #Doorfaceupcharge, #doorW, #DoorH , #DoorPrintOrderNumber, 


Set,  (#DoorSD>0): #UnitDoorCost = [[#UnitDoorCost] + [#CostOfDoor]]
Set,  (#DoorSD>0): #TotalNumDoors = [#TotalNumDoors + 1]
}

Do, (#DoorDrawerType = "#DoorDrawerTypeName2")&(#CFSpecialdoors=0):1              ,flat edgeband door cost 2nd color
{
,Edgeband doors allowed sizes contrast melamine
Set,(#IncludeInsert=0):#CostOfDoor=(#TempDoorCost*#edgebanddoorspecialfinishcost)*#DoorDrawerTypeCostFactor2 , flat door 

,Framed doors allowed sizes contrast melamine
Set,(#IncludeInsert=1)&(#Tempdoorcost>0):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#GlassDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Solid")|(#Codedoor="flat-HG-Solid")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#14melamineDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Solid")|(#Codedoor="flat-HG-Solid")):#DoorDrawerInsertType=#DoorDrawerInsert14Mel
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Speaker")|(#Codedoor="flat-HG-Speaker")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#SpeakerDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Speaker")|(#Codedoor="flat-HG-Speaker")):#DoorDrawerInsertType=#DoorDrawerInsertSpeaker
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Smoke")|(#Codedoor="flat-HG-Smoke")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#SmokeDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Smoke")|(#Codedoor="flat-HG-Smoke")):#DoorDrawerInsertType=#DoorDrawerInsertSmoke
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Mirror")|(#Codedoor="flat-HG-Mirror")):#CostOfDoor=((#TempDoorCost*#edgebanddoorspecialfinishcost)+#MirrorDoorExtraCost)*#DoorDrawerTypeCostFactor1 ,  Framed flat door melamine insert 
Set,(#IncludeInsert=1)&(#Tempdoorcost>0)&((#Codedoor="flat-VG-Mirror")|(#Codedoor="flat-HG-Mirror")):#DoorDrawerInsertType=#DoorDrawerInsertMirror

Set,(#IncludeInsert=1)&(#Tempdoorcost=0):#CostofDoor=0

Price,(#CostOfDoor>0)&(#IncludeInsert=0):1 ,#DoorName-#ContrastMaterialName-#contrastMaterialCostGroup-#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,   
Price,(#CostOfDoor>0)&(#IncludeInsert=1):1 ,Framed #DoorName-#ContrastMaterialName-#contrastMaterialCostGroup-#DoorDrawerInsertType#edgebandfinish,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,


Set,  (#DoorSD>0): #UnitDoorCost = [[#UnitDoorCost] + [#CostOfDoor]]
Set,  (#DoorSD>0): #TotalNumDoors = [#TotalNumDoors + 1]
}

Do, (#DoorDrawerType <> "#DoorDrawerTypeName1")&(#DoorDrawerType <> "#DoorDrawerTypeName2")&(#CFSpecialdoors=0):1              ,Custom Door cost
{
Set,(#DoorW>#Maxdoorwidth)&(#wallbeddepthtrack=0): #Costofdoor=0, invalid size
Set,(#IncludeInsert=1)&(#Tempdoorcost=0)&((#Codedoor="flat-VG-Solid")|(#Codedoor="flat-HG-Solid")):#IncludeInsert=0
Set,(#IncludeInsert=1)&(#Tempdoorcost=0)&((#Codedoor="flat-VG-Speaker")|(#Codedoor="flat-HG-Speaker")):#DoorDrawerInsertType=#DoorDrawerInsertSpeaker
Set,(#IncludeInsert=1)&(#Tempdoorcost=0)&((#Codedoor="flat-VG-Smoke")|(#Codedoor="flat-HG-Smoke")):#DoorDrawerInsertType=#DoorDrawerInsertSmoke
Set,(#IncludeInsert=1)&(#Tempdoorcost=0)&((#Codedoor="flat-VG-Mirror")|(#Codedoor="flat-HG-Mirror")):#DoorDrawerInsertType=#DoorDrawerInsertMirror

 Do,(#DoorW<=#Maxdoorwidth)|(#wallbeddepthtrack=1):1
 {
 , solid doors
 Price,(#CostOfDoor>0)&(#IncludeInsert=0)&(#CFSpecialdoors=0):1   ,#DoorName-#DoorDrawerFinishingType,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,
 ,Framed doors 
 Price,(#CostOfDoor>0)&(#IncludeInsert=1):1   ,#DoorName-#DoorDrawerFinishingType-#DoorDrawerInsertType,    #CostOfDoor,    #DoorW, #DoorH, #DoorPrintOrderNumber,


 Set,  (#DoorSD>0): #UnitDoorCost = [[#UnitDoorCost] + [#CostOfDoor]]
 Set,  (#DoorSD>0): #TotalNumDoors = [#TotalNumDoors + 1]
 }
}

,Update V7.2.9 start
set, #UnitDoorArea=[(#UnitDoorArea+#DoorA)*num]
set, #UnitDoorNum=[(#UnitDoorNum+1)*num]
,Update V7.2.9 end

}

,Left Door of a pair
Set,  (#DoorLD>0): #ThisDoor = #DoorLD                                    ,LEFT DOOR OF PAIR
set, #whichdoor=Pairleft
Do, (#DoorLD>0):1
{
Load, (#DoorLD>0): DoorSet.Pcb
Load, (#DoorLD>0): DoorHandleKnob.Pcb
Load, (#DoorLD>0): Glassdr.Pcb

