 Do, (#NumSideThick >1):1
 {
  DisplaySet, #SideThickB =1.5, 1 Q...     WHAT IS THE THICKNESS OF YOUR 2nd VERTICAL SIDE? (NEXT THICKEST)
  Do, (#sideTH >= #SideThickB):1
  {
  Load, B-Sidecostdoublethick.pcb
  }
 }
Do, (#NumSideThick >2):1
 {
  DisplaySet, #SideThickC =2.25, 1 Q...     WHAT IS THE THICKNESS OF YOUR 3rd VERTICAL SIDE? (THICKEST)
  Do, (#sideTH >= #SideThickC):1
  {
  Load, B-Sidecosttriplethick.pcb
  }
 }

}


,**
,**
,******************************* Side Hardware Costs ************************************
DisplaySet, #CostAddedToSides =+0,          1.   Cost added to each Side for hardware.

,Set the Cost of Each Type of Vertical
,Set, #CostOfSide =  [(#CostOfVertical + #CostAddedToSides)]

,KF
Set,#CostOfSide=[(#CostofVertical#CostAddedToSides)]
Load,GetMaterialCostSide.pcb

set, (#wallbeddepthtrack=1): #addpanel=15
set, (#wallbeddepthtrack=1): #temppanelcount=0
load, countsides.pcb

,Calculates the Name of All Verticals
Load,(#UsePartNames=No):  J-VerticalNames.Pcb



