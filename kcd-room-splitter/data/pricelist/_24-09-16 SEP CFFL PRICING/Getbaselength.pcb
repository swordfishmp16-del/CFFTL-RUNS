
,If there is no unit or wall on left(ubl=0) and right (ubr=0) and nowrapbase=0 then kick length equals unit width+depth left+depth right
Do, (K<>0)|(T=230)|((T=890)&(#UnitFileName<>"890nc.cab")):1
{
,Set,((ult=0)&(#noreturnbase=0)&(T<>230))|((ublt<>0)&(ublz=>k))|((ublt<>0)&(ublK=0)):#KickFinishLeft=1:#KickFinishLeft=0
,Set,((urt=0)&(#noreturnbase=0)&(T<>230))|((ubrt<>0)&(ubrz=>k))|((ubrt<>0)&(ubrK=0)):#KickFinishRight=1:#KickFinishRight=0
,Set,(T=890):#KickFinishRight=0
,Set,(T=890):#KickFinishLeft=0
,set, #baselength=0
,Set, (nkhyn=0):#baselength=W:#baselength=w-ls-rs
,set,((T=230)|(T=890)):#baselength=w
,set,(#name="No-price base board for show"):#baselength=0
,Set,((T=230)&(#noreturnbase=1)):#baselength=0
,Set,((T=550)&(#noreturnbase=1)):#baselength=0
,Set,((T=230)&(#noreturnbase=0)):#baselength=w
,Set,((T=550)&(#noreturnbase=0)):#baselength=w
,Set,#KickBaseLengthsub=(#baselength+((d+6)*#KickFinishLeft)+((d+6)*#KickFinishRight))
,***
set, ((#ExtraUnitText5="*Continuous*")|(#ExtraUnitText5="#Basetype0")):#noreturnbase=1:#noreturnbase=0

set, #stopgetbaselength=1
set, #KickFinishLeft=0
set, #KickFinishright=0
,set, #crownbaseslop=6
Set,((ult=0)&(#noreturnbase=0)):#KickFinishLeft=1
Set,((uld>0)&(ulz=>K)):#KickFinishLeft=1
Set,((uld>0)&(ulK=0)):#KickFinishLeft=1
Set,((ult=645)&(#noreturnbase=0)):#KickFinishLeft=1

Set,((urt=0)&(#noreturnbase=0)):#KickFinishRight=1
Set,((urd>0)&(urz=>K)):#KickFinishRight=1
Set,((urd>0)&(urK=0)):#KickFinishRight=1
Set,((urt=645)&(#noreturnbase=0)):#KickFinishRight=1

set,((T=230)|(T=890)|(T=645)|(T=640)):#Kickfinishleft=0
set,((T=230)|(T=890)|(T=645)|(T=640)):#Kickfinishright=0

set, #baselength=0
Set, (nkhyn=0):#baselength=W:#baselength=(w-ls-rs)
set,((T=230)|(T=890)|(T=645)|(T=640)):#baselength=(w)
set,((T=890)&(#UnitFileName="890nc.cab")):#baselength=0
Set,((T=230)&(#noreturnbase=1)):#baselength=0
Set,((T=550)&(#noreturnbase=1)):#baselength=0
Set,((T=230)&(#noreturnbase=0)):#baselength=w
Set,((T=550)&(#noreturnbase=0)):#baselength=w
Set,#KickBaseLengthsub=(#baselength+((d+#crownbaseslop)*#KickFinishLeft)+((d+#crownbaseslop)*#KickFinishRight))
,***



Set,#KickBaseLengthTotal=[#KickBaseLengthsub+#KickBaseLengthTotal]

Set,#KickBaseCostSub=(#KickBaseLengthTotal*#BaseTypeCostGroup)
Set,#KickBaseTotCost=[#KickBaseTotCost+#KickBaseCostSub]

, Track base moulding for job by type
Do, (#KickBaseLengthsub>0):1  ,Unit has molding
{
 Do, (#BaseType = "#BaseType0"):1
   {
      set, #BMld0Name = <#BaseType>
      set, #BMld0Len = [#BMld0Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType1"):1
   {
      set, #BMld1Name = <#BaseType>
      set, #BMld1Len = [#BMld1Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType2"):1
   {
      set, #BMld2Name = <#BaseType>
      set, #BMld2Len = [#BMld2Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType3"):1
   {
      set, #BMld3Name = <#BaseType>
      set, #BMld3Len = [#BMld3Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType4"):1
   {
      set, #BMld4Name = <#BaseType>
      set, #BMld4Len = [#BMld4Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType5"):1
   {
      set, #BMld5Name = <#BaseType>
      set, #BMld5Len = [#BMld5Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType6"):1
   {
      set, #BMld6Name = <#BaseType>
      set, #BMld6Len = [#BMld6Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType7"):1
   {
      set, #BMld7Name = <#BaseType>
      set, #BMld7Len = [#BMld7Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType8"):1
   {
      set, #BMld8Name = <#BaseType>
      set, #BMld8Len = [#BMld8Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType9"):1
   {
      set, #BMld9Name = <#BaseType>
      set, #BMld9Len = [#BMld9Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType10"):1
   {
      set, #BMld10Name = <#BaseType>
      set, #BMld10Len = [#BMld10Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType11"):1
   {
      set, #BMld11Name = <#BaseType>
      set, #BMld11Len = [#BMld11Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType12"):1
   {
      set, #BMld12Name = <#BaseType>
      set, #BMld12Len = [#BMld12Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType13"):1
   {
      set, #BMld13Name = <#BaseType>
      set, #BMld13Len = [#BMld13Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType14"):1
   {
      set, #BMld14Name = <#BaseType>
      set, #BMld14Len = [#BMld14Len + (#KickBaseLengthsub)]
   }
 Do, (#BaseType = "#BaseType15"):1
   {
      set, #BMld15Name = <#BaseType>
      set, #BMld15Len = [#BMld15Len + (#KickBaseLengthsub)]
   }  
}




, Track base moulding for job by room

Do, (#RoomNum=1):1
   {
      Do,(#Name<>"Garage Wood Base"):1
      {
      Set, #Rm1BaseLengthtotal = [#Rm1BaseLengthtotal+(#KickBaseLengthsub)]
      Set, (#baselength>#secMinSize)&(#baselength<=#secMaxSize)&(T<>550):#Rm1BaseQty=[#Rm1BaseQty+1]
      Set, (#baselength>#secMaxSize)&(T<>550):#Rm1BaseQty=[#Rm1BaseQty+(#baselength\#secMaxSize)]
      Set, (#baselength>#secMaxSize)&((#baselength/#secMaxSize)-(#baselength\#secMaxSize)>0):#Rm1BaseQty=[#Rm1BaseQty+1]
      ,Set, #Rm1BaseCost =[#Rm1BaseQty*#BaseTypeCostGroup]
      }
      Do,(#Name="Garage Wood Base"):1
      {
       Set, #Rm1GarageWoodBaseLengthtotal = [#Rm1GarageWoodBaseLengthtotal+(#KickBaseLengthsub)]
      }
   }

