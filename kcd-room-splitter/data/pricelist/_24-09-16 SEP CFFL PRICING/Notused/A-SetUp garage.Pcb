,Not needed below set through unit info
,,*************************************************************  MATERIAL **************************************************************************
,,**
,Change below after = Set cabinet material type
,DisplaySet,#Material =White Melamine,      Material used in this Price List
Set,#Material =White Melamine,      Material used in this Price List
,**

,Below lines put the word display in front to view in the grid
,Markup is only reflected in the room by room report***SEE H-Discounts and Fees.PCB
,Set,#DesignerMarkup=00, Markup - will only be refleted in the room by room report answer 01 for 1 percent
,Below will send the pricing information to a csv file 
Set,#TurnOnSendTOFile=Yes, Do you want to create a csv file with the job name every time you run the pricing? [Yes;No]
Set,#DestinationPath=C:\KCDw, Path for csv file that will be created
Set,#CSVName=#JobExportName, Name for default csv report
,Below will send just the room subtotals to a csv file - the name of this file will be the name of the job + RBR
Set,#TurnOnRBRSendTOFile=Yes, Do you want to create a csv file with the job name + RBR every time you run the pricing? [Yes;No]
Set,#DestinationPath=C:\KCDw, Path for room by room csv file that will be created
Set,#RBRName=#JobExportName + RBR, File Name for the room by room csv file
,Below is the variable that contains all the information that will be sent to the csv file
,Set,#StuffForCSV =#UnitNumber#Comma#Number#Comma#Name#Comma#Cost#Comma#Length#Comma#Width#Comma#Depth#Comma#Material#Comma#WallName#Comma#RoomName#Comma#RoomNum
Set,#StuffForCSV =#RoomName#Comma#WallNumber#comma#Number#Comma#Name#Comma#Material#Comma#Length#Comma#Width#Comma#Depth#Comma#Cost

Erase,#DestinationPath\#CSVName.csv
Erase,#DestinationPath\#RBRName.csv


Set,#SectionDivisor=[36in]
Set,#LinealDivisor=[12in]
Set,#SquareDivisor=[144in]
Set,#CubicDivisor=[1728in]

Set,#SectionFactor=/#SectionDivisor
Set,#LinealFactor=/#LinealDivisor
Set,#SquareFactor=/#SquareDivisor
Set,#CubicFactor=/#CubicDivisor

,Set in User file hidden for that reason
,,***************************************************  DOOR HARDWARE COST Door Hardware Set in a-user file *****************************************************************
,**
,Door Hardware Set in a-user file
,DisplaySet, #HandleCost$ =#UnitDoorHandleCost,          1.   Cost added to each Door for Handles.
,DisplaySet, #KnobCost$ =#UnitDoorHandleCost,          2.   Cost added to each Door for Knobs.
,DisplaySet, #HingeCost$ =0,          3.   Cost added to each Door for Hinges.
Set, #HandleCost$ =#UnitDoorHandleCost,          1.   Cost added to each Door for Handles.
Set, #KnobCost$ =#UnitDoorHandleCost,          2.   Cost added to each Door for Knobs.
Set, #HingeCost$ =0,          3.   Cost added to each Door for Hinges.




,**

,**************************************** SIDE - SHELF PRICE METHOD *********************************************
,**


DisplaySet, #SideCostMethod =List, Q...     PRICING METHOD FOR VERTICAL SIDES - (By Square Foot)  or  (From Size Look Up List)  [SqFt;List]
,**          * Click on ''B-Side Cost.Pcb'' in Quick Load to set details
,**

,Set all Costs for Sides
,Load, B-Side Cost.Pcb


DisplaySet, #ShelfCostMethod =List, Q...     PRICING METHOD FOR HORIZONTAL SHELVES - (By Square Foot)  or  (From Size Look Up List)  [SqFt;List]
,**          * Click on ''C-Shelf Cost.Pcb'' in Quick Load to set details
,**

,Set all Costs for Sides
,Load, C-Shelf Cost.Pcb

,**************************************** DRAWER FRONT METHOD *********************************************
,**

,DisplaySet, #DoorCostMethod =List, Q...     PRICING METHOD FOR DOORS & DRAWER FRONTS - (By Square Foot)  or  (From Size Look Up List)  [SqFt;List]
DisplaySet, #PriceDrawerFronts =Yes,Q...     Price Drawer Fronts like Doors = Yes     OR     Include Drawer Fronts with Drawer Box cost = No  [Yes;No]
,**          * Click on ''D-Door Cost.Pcb'' in Quick Load to set details

,**
Displayset, #Garagepricing=Unit,Q...     PRICING METHOD FOR Garages (per Unit)    OR    (set Piece)   [Unit;Pieces]

DisplaySet, #CubbyCostMethod =Pieces, Q...     PRICING METHOD FOR CUBBY HOLES    (per hole)    OR    (set cost)   OR   (per each piece needed to make unit)  [Hole;Cost;Pieces]
Do,(#CubbyCostMethod="Hole"):1
{
DisplaySet,#CostOfCubbyUnit =100.00,    Cost per Each Cubby Hole 
}

Do,(#CubbyCostMethod="Cost"):1
{
DisplaySet,#CostOfCubbyUnit =100.00,    Cost of Cubby Hole Unit
}
Do,(#CubbyCostMethod="Pieces"):1
{
Set,#CostOfCubbyUnit =0.00,    Cost of Each Cubby Hole Unit
}




,,*************************************************** OTHER PRICES *****************************************************************
,,**



DisplaySet, #ShowOtherPrices =Yes, Q...     Show Other Prices [Yes;No]

Do, (#ShowOtherPrices ="Yes")|(#DisplayEdit):1
{
   
   ,**     *****   Set Other Prices  -  By Cost Each  -  By Length Cost  -  By Area Cost
   DisplaySet,#CostBackPerSqFtTemp =#BackTypeCostGroup,          1.1      Cost of Back Material per Square Foot
   Set, #CostBackPerSqFt = (#CostBackPerSqFtTemp)
   
   DisplaySet,#CostMirrorBackPerSqFt =20,          1.2      Cost of Mirror Back Material per Square Foot
**Update V7.2.4 start Kick cost now set in AA-User.pcb
   ,Set,#CostKickPerFtTemp =#BaseCostPerUnitSection,          1.3      Cost of Kick per piece
   ,Set, #CostKickPerFt = (#CostKickPerFtTemp)
**Update V7.2.4 end
   
   DisplaySet,#CostSpannerPerFtTemp =0,          1.4      Cost of Spanner Material per Lineal Foot
   Set, #CostSpannerPerFt = (#CostSpannerPerFtTemp/#LinealDivisor)
   
   DisplaySet,#WireShelfCostTemp =0.00,          1.5      Cost of Wire Shelves per Lineal Foot
   Set,#WireShelfCost = (#WireShelfCostTemp/#LinealDivisor)
   
   ,DisplaySet,#CostOfClosetPoleTemp =7.00 ,          1.5      Cost of Each Closet Pole per Lineal Foot
   ,Set,#CostOfClosetPole = (#CostOfClosetPoleTemp/#LinealDivisor)
   
   DisplaySet,#WireSupportCost =0.00,          1.6      Cost of Each Wire Shelf Support
   DisplaySet,#CostOfStdBeltRack =65,          1.7.0      Cost of Each Standard Belt Rack
      ,DisplaySet,#CostOfU1BeltRack =75,          1.7.1      Cost of Each Upgrade 1 Belt Rack
      ,DisplaySet,#CostOfU2BeltRack =85,          1.7.2      Cost of Each Upgrade 2 Belt Rack
   DisplaySet,#CostOfStdTieRack =65,          1.8.0      Cost of Each Standard Tie Rack
     ,DisplaySet,#CostOfU1TieRack =75,          1.8.1      Cost of Each Upgrade 1 Tie Rack
     ,DisplaySet,#CostOfU2TieRack =85,          1.8.2      Cost of Each Upgrade 2 Tie Rack
   DisplaySet,#CostOfStdValetRod =65,          1.9.0      Cost of Each Standard Valet Rod
     ,DisplaySet,#CostOfU1ValetRod =75,          1.9.1      Cost of Each Upgrade 1 Valet Rod
     ,DisplaySet,#CostOfU2ValetRod =85,          1.9.2      Cost of Each Upgrade 2 Valet Rod
   DisplaySet,#CostOfScarfRack =85,          1.10      Cost of Each Scarf Rod
   DisplaySet,#CostOfDoubleHook =35,          1.11      Cost of Each Double Hook
   DisplaySet,#CostOfTriplePullDown =200,          1.12      Cost of Each Triple Pull Down Rod
   DisplaySet,#CostOfDetailBaseTemp =175,          1.13    Cost of Base Board per Section foot
   Set,#CostofBase=(#CostofDetailBaseTemp/#SectionDivisor)
   DisplaySet,#CostOfLegLevelers =40,          1.14    Cost of Section Leg Leveler
   DisplaySet,#CostOfFiller =40,          1.15    Cost of Each Filler
   DisplaySet,#CostPerSqFttemp =7.00,          1.16    Cost for Other Material per Square Foot (ex. top panel end see cost formulas below for more ex)
   Set,#CostPerSqFt = (#CostPerSqFttemp/#SquareDivisor)
   DisplaySet,#CostOfFlutedPilaster =#FlutedPilasterStyleCostGroup,          1.17    Cost of Each Fluted Pilaster

   ,closets doesn't have a half wall
   Set,#CostOfHalfWall =100,              Cost of Each Half Wall
   DisplaySet,#Rosette =50.00,          1.18    Cost of Each Rosette
   DisplaySet,#CostSlatWallPerSqFtTemp =10,          1.19      Cost of Slat Wall Material per Square Foot
   ,Set, #CostSlatWallPerSqFt = (#CostSlatWallPerSqFtTemp/#SquareDivisor)
   Set, #CostSlatWallPerSqFt = #CostSlatWallPerSqFtTemp
   DisplaySet,#CostOfSlatHook =5.00,          1.20    Cost of Each Slat Hook
   DisplaySet,#CostofStemWareHolder18=150,         1.21.1    Cost of 18" Stem Ware Holder
   DisplaySet,#CostofStemWareHolder30=200,         1.21.2    Cost of 30" Stem Ware Holder
   DisplaySet,#CostofStemWareHolder36=225,         1.21.3    Cost of 36" Stem Ware Holder
   DisplaySet,#CostofWineHolder=300,         1.22    Cost of Wine Holder
   DisplaySet,#14glasscost=20,         1.23.1    Cost 1/4" Thick glass shelf
   DisplaySet,#38glasscost=35,         1.23.2    Cost 3/8" Thick glass shelf
   DisplaySet,#12glasscost=50,         1.23.3    Cost 1/2" Thick glass shelf
   DisplaySet,#glassbevelperinch=3,         1.23.4    Cost glass bevel per inch
   DisplaySet,#melcorbelcost=50,         1.24.1    Cost Melamine CF corbel
   DisplaySet,#MDFcorbelcost=80,         1.24.2    Cost MDF CF corbel
   DisplaySet,#veneercorbelcost=100,         1.24.3    Cost Veneer CF corbel
   Displayset,#Dogearpanelcost=30,        1.25.1    Cost to dogear cut a panel
   Displayset,#FinaldogearDepth=304.8MM, 1.25.2----- Depth of Top piece when dog ear top clip option activated?
   Displayset,#Baseboardnotchcharge=0,   1.25.3      Charge to notch back of panels over room baseboard.
   Displayset,#Hutchpanelcharge=50,      1.25.4      Upcharge for hutch panel cuts.
   Displayset,#FullLEDPanelStripcost=200, 1.26.1 Cost of Full Panel Routed LED Strip
   Displayset,#HalfLEDPanelStripcost=135, 1.26.2 Cost of Half Panel Routed LED Strip
   Displayset,#LEDShelfStripcost=100, 1.26.3 Cost of Shelf Routed LED Strip
   Displayset,#CostofSwivelmirror=365, 1.27 Cost of Pull-out Swival Mirror
}
,**********************************************************************


,**
,**
,**

DisplaySet, #ShowCostFormulas =Yes, Q...     Show Cost Formulas [Yes;No]

Do, (#ShowCostFormulas ="Yes")|(#DisplayEdit):1
{
   
   ,**     *****   Cost Formulas  (Example:    Line 2.15     "W * H * #CostBackPerSqFt"      Multiplies a backs Width times its Height times its Cost per Sq Ft)
   DisplaySet,#CostOfBack =((#ShelfWidth*#backheight)/144)*#CostBackPerSqFt,          2.1      Cost Formula for a Back
**Update V7.2.4 start
   ,Displayset, #alwayschargeforkick=Yes, 2.2 Do you charge for standard inset Kick when base molding is added? [Yes;No]
  , DisplaySet,#CostOfKick =8,          2.2a      Cost Formula for a standard Inset Kick per section
**Update V7.2.4 end
   DisplaySet,#CostOfTopSpanner =(W-LS-RS)  * #CostSpannerPerFt*#MaterialCostGroup,          2.3      Cost Formula for a Horizontal Top Spanner
   DisplaySet,#CostOfMiddleSpanner =(W-LS-RS)  * #CostSpannerPerFt*#MaterialCostGroup,          2.4      Cost Formula for a Horizontal Middle Spanner
   ,below isn't set anywhere
   ,Set,#CostOfDivider =H * D * #CostPerSqFt,          2.5      Cost Formula for an internal Divider
   DisplaySet,#CostOfTopPanel =D * H * #CostPerSqFt*#MaterialCostGroup,          2.5      Cost Formula for a Top Panel End (Other Material)
   DisplaySet,#CostOfTopBPanel =W * H * #CostPerSqFt*#MaterialCostGroup,          2.6      Cost Formula for a Top Back Panel (Other Material)
   DisplaySet,#CostOfBasePanel =D * H * #CostPerSqFt*#MaterialCostGroup,          2.7      Cost Formula for a Base Panel End (Other Material)
   DisplaySet,#CostOfBaseBPanel =W * H * #CostPerSqFt*#MaterialCostGroup,          2.8      Cost Formula for a Base Back Panel (Other Material)
   DisplaySet,#CostOfTallPanel =D * H * #CostPerSqFt*#MaterialCostGroup,          2.9    Cost Formula for a Tall Panel End (Other Material)
   DisplaySet,#CostOfTallBPanel =W * H * #CostPerSqFt*#MaterialCostGroup,          2.10    Cost Formula for a Tall Back Panel (Other Material)
   DisplaySet,#CostOfWireShelf =W * #WireShelfCost,          2.11    Cost Formula for a Wire Shelf
   DisplaySet,#CostOfWireSupport =#WireSupportCost,          2.12    Cost Formula for a Wire Shelf Support
   ,below is set in the c-shelf-cost file
   ,Set,#CostOfShoeShelf =(W-LS-RS)* D * #CostPerSqFt,          2.14    Cost Formula for a Shoe Shelf
   DisplaySet,#CostOfCShelfSupport =W * D * #CostPerSqFt,          2.13    Cost Formula for a Corner Shelf Support (Other Material)
   ,DisplaySet,#ClosetPoleCost =W * #CostOfClosetPole,          2.14    Cost Formula for a Closet Pole
   DisplaySet,#CostOfShelfSupport =#Cleatlength/12 *5,          2.15    Cost Formula for a Straight Ledger Shelf Support (Other Material)
**Update V7.2.4 start specified name as arched base
   DisplaySet,#CostofDetailBase=(W * #CostofBase) + (bbl * #CostOfBase * d) + (bbr * #CostOfBase * d),         2.16   Cost Formula for Arch Base Board
**Update V7.2.4 end
   DisplaySet,#CostofSlatWall=((W * H)/144) * #CostSlatWallPerSqFt),         2.17   Cost Formula for Slat Wall
}
,**********************************************************************



