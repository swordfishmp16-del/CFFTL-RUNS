use grid

,This is here so I can test popup regarding the countertop edges eventually
,Set, #IncludeBackName =Include Backs Yes or No?, --- Include Backs Question?
,DisplaySet, #IncludeBacksName =Include Backs Yes or No?, --- Include Backs Question?
,AskQuestion,#IncludeBacksYN,No,#IncludeBacksName  [Yes;No]


,**-----------------------KCDW COUNTERTOP PRICING---------------------------

,**  SECTION 12 Countertop Cost
DisplaySet,#CountertopType0=None,12.0         Countertop 0 Name
