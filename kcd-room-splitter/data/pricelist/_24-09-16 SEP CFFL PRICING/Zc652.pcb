,CF***Double Hanging***
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
Load, Pricesides.pcb     
,*****************************************



,********* All VERTICAL DIVIDERS *********
         
,*****************************************



,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
set, (LMR>0):#lowerspannercount=1
Load, Pricefixedshelves.pcb   
,*****************************************




,*********** All ADJ SHELVES *************
   
,*****************************************

,************* Closet Poles ***************

load, Pricerods.pcb
,****************************************** 
Do, (#Unitfilename="ESS-*")&(#unitfilename<>"*NoCleat*"):1
{

Price, 1,#ShelfSupportName,      #EssentialsCleatcost,        w-ls-rs ,#essentialscleatHeight,          #ShelfSupportPrintOrderNumber,     
}


,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber, 

Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
,Load, Doors.pcb
,*****************************************



,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************



