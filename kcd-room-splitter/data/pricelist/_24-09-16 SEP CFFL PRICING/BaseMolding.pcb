     set,(#moldingscale="foot")&(#basemoldremainder>0):#Room25BaseMoldLength = [#Room25BaseMoldLength + 1]
     Set,(#moldingscale="8 foot"):#Room25BaseMoldLength=[#Rm25BaseLengthtotal\96]
     set,(#moldingscale="8 foot"):#basemoldremainder = [(#Rm25BaseLengthtotal/96)-(#Rm25BaseLengthtotal\96)]
     set,(#moldingscale="8 foot")&(#basemoldremainder>0):#Room25BaseMoldLength = [#Room25BaseMoldLength + 1]
     Set,(#moldingscale="metric"):#Room25BaseMoldLength=[#Rm25BaseLengthtotal] 
     Set,(#moldingscale<>"Section"):#Rm25basecost=[#Room25BaseMoldLength*#Room25basecostgroup]
     Set,(#moldingscale<>"Section"):#Rm25BaseQty=[#Room25BaseMoldLength]
     Set,(#moldingscale="Section"):#Rm25basecost=[#Rm25BaseQty*#Room25basecostgroup]

     Set, #Rm25basecost=[#Rm25basecost*#universalupcharge]
     }
     Do,(#Rm25GarageWoodBaseLengthtotal>0):1
     {
     Set,(#Rm25GarageWoodBaselengthtotal<=96):#Rm25WGbasecost=#woodgaragebasesmallcost
     Set,((#Rm25GarageWoodBaselengthtotal>96)&(#Rm25GarageWoodBaselengthtotal<=144)):#Rm25WGbasecost=#woodgaragebasemediumcost
     Set,(#Rm25GarageWoodBaselengthtotal>144):#Rm25WGbasecost=#woodgaragebaselargecost
     Set, #Rm25WGbasecost=[#Rm25WGbasecost*#universalupcharge]
     }



End

