,KCDw System File. Do NOT Change in any way.
,set,#moldremainder=0
,set, #measurescale=-
,set,(#incm="-inch")&(#moldingscale="inch"):#measurescale=-in
,set,(#incm="-inch")&(#moldingscale="foot"):#measurescale=-ft
,set,(#incm="-inch")&(#moldingscale="8 foot"):#measurescale=-8 ft Segments
,set,(#incm="-Mm")&(#moldingscale="metric"):#measurescale=-Millimeter
,set,(#incm="-Cm")&(#moldingscale="metric"):#measurescale=-Centimeter


, BASE MOULDING LENGTHS FOR REPORT
     Do,(#Rm1BaseLengthtotal>0):1
     {


     Set,(#moldingscale="inch"):#Room1BaseMoldLength=[#Rm1BaseLengthtotal]
     Set,(#moldingscale="foot"):#Room1BaseMoldLength=[#Rm1BaseLengthtotal\12]
     set,(#moldingscale="foot"):#basemoldremainder = [(#Rm1BaseLengthtotal/12)-(#Rm1BaseLengthtotal\12)]
     set,(#moldingscale="foot")&(#basemoldremainder>0):#Room1BaseMoldLength = [#Room1BaseMoldLength + 1]
