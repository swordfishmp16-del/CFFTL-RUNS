     set,(#moldingscale="8 foot"):#basemoldremainder = [(#Rm1BaseLengthtotal/96)-(#Rm1BaseLengthtotal\96)]
     set,(#moldingscale="8 foot")&(#basemoldremainder>0):#Room1BaseMoldLength = [#Room1BaseMoldLength + 1]
