,CF Upper L Corner Right with Doors
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [LCCD]
Set, (PT=0):#ShelfWidth = [(W-LS)]:#Shelfwidth=[(W-LS-0.75)]
Set, (PT=0):#ShelfDepth = [(D-RS-0.75)]:#Shelfdepth=[(D-RS)]
Load, PricecornersidesR.pcb        
,*****************************************




,*********** All SHELVES ***********
Set, #ShelfWidth = [(W-LS)]
Set, #ShelfDepth = [(LCCD)]
Load, PricecornerLshelvesR.PCB            
,*****************************************

 ,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************     


,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
Set, (PT=0):#Shelfwidth=[(D-RS-0.75)]:#ShelfWidth = [(W-LS-0.75)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,          
,Price, 1,            #ClosetPoleName,       #ClosetPoleCost,         (W-LS-RS), 1,  #ClosetPolePrintOrderNumber,        
,*** No Kick    Price, (K>0):1,    #KickName,               #CostOfKick,             #ShelfWidth+3, K,        #KickPrintOrderNumber,              
,*** Kick priced per unit    Price, (K>0):1,    #KickName,               #CostOfKick,             #ShelfDepth+3, K,        #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************



,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************


