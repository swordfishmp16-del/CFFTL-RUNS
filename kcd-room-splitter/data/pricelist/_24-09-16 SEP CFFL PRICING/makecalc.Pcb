set,#BaseSquareTotal=[#BaseSquareTotal+(#unitsquare*num)]
set,#BaseCubicTotal=[#BaseCubicTotal+(#unitcubic*num)]
set,#BaseNumofUnits=[#BaseNumofUnits + num]

