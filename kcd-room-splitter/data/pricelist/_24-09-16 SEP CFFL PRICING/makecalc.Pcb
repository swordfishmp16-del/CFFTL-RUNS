set,#linealtotal=[#linealtotal+(#unitlineal*num)]
set,#squaretotal=[#squaretotal+(#unitsquare*num)]
set,#cubictotal=[#cubictotal+(#unitcubic*num)]
set,#NumofUnits=[#NumofUnits + num]


,For Top Cabinets
do, (t>=100) & (t<200) & (t<>150):1
{
set,#WallLinealTotal=[#WallLinealTotal+(#unitlineal*num)]
set,#WallSquareTotal=[#WallSquareTotal+(#unitsquare*num)]
set,#WallCubicTotal=[#WallCubicTotal+(#unitcubic*num)]
set,#WallNumofUnits=[#WallNumofUnits + num]

}

,For Base Cabinets
do, (t>=200) & (t<300)&(t<>230):1
{
set,#BaseLinealTotal=[#BaseLinealTotal+(#unitlineal*num)]
set,#BaseSquareTotal=[#BaseSquareTotal+(#unitsquare*num)]
set,#BaseCubicTotal=[#BaseCubicTotal+(#unitcubic*num)]
set,#BaseNumofUnits=[#BaseNumofUnits + num]

}

,Base Fillers
do, (t=230)&(#Ztype="231"):1
{
