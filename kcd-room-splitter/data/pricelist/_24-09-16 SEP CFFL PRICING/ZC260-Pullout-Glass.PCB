
,CF Library - Closet Pieces
,******** ALL PULLOUTS Clear Acrylic*************
Set, #PulloutOpeningWidth = W
Set, #ShelfWidth = [(W)]     
Set, #ShelfDepth = [(D)]

Set, #shelfTH=#ShelfThickA

Set, #W = [(#PulloutOpeningWidth/NDiv) -1]
Set, #H = H
Set, #D = [D]


Set, #H = {#H}

Do,(#traypricemethod="Shelf Cost Plus"):1
{
Set, #PulloutOpeningWidth = W
Set, #ShelfWidth = [(W)]     
Set, #ShelfDepth = [(D)]
set, #Tempshelfcount=1
Set, #shelfTH=#ShelfThickA
Load, C-Shelf Cost.pcb
set, #displaycost=#CostofAdjustableShelf
,Load, Priceadjshelves.pcb



,**


Set, #W = [(#PulloutOpeningWidth/NDiv) -1]
Set, #H = H
Set, #D = [D]


Set, #H = {#H}



Price, (#Unitfilename="*-Glass*")&(#Unitfilename<>"*Under*"):1, RM#Roomnum Pullout Tray w/Clear Acrylic Front #H"-#unitmaterialname,   (#Costfortray+#Acrylictrayfrontcost+#displaycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*-Glass*")&(#Unitfilename="*Under*"):1, RM#Roomnum Under Mt Pullout Tray w/Clear Acrylic Front #H"-#unitmaterialname,   (#Costfortray+#Acrylictrayfrontcost+#displaycost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Matte*")&(#Unitfilename<>"*Under*"):1, RM#Roomnum Pullout Tray w/Matte Acrylic Front #H"-#unitmaterialname,   (#Costfortray+#Mattetrayfrontcost+#displaycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Matte*")&(#Unitfilename="*Under*"):1, RM#Roomnum Under Mt Pullout Tray w/Matte Acrylic Front #H"-#unitmaterialname,   (#Costfortray+#Mattetrayfrontcost+#displaycost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,
}
,***********************************

Do,(#traypricemethod="Fixed Style Cost"):1
{
Price, (#Unitfilename="*-Glass*")&(#Unitfilename<>"*Under*"):1, RM#Roomnum Pullout Tray w/Clear Acrylic Front #H"-#unitmaterialname,   (#Acrylictrayfrontcost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*-Glass*")&(#Unitfilename="*Under*"):1, RM#Roomnum Under Mt Pullout Tray w/Clear Acrylic Front #H"-#unitmaterialname,   (#Acrylictrayfrontcost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Matte*")&(#Unitfilename<>"*Under*"):1, RM#Roomnum Pullout Tray w/Matte Acrylic Front #H"-#unitmaterialname,   (#Mattetrayfrontcost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Matte*")&(#Unitfilename="*Under*"):1, RM#Roomnum Under Mt Pullout Tray w/Matte Acrylic Front #H"-#unitmaterialname,   (#Mattetrayfrontcost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,

}


