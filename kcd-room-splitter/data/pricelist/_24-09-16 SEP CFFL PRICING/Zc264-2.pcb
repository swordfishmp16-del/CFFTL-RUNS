,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
Load, pricesides.pcb
,*****************************************


,********* All VERTICAL DIVIDERS *********
,Vertical Divider
Set, #VertH = [DH1]
Set, #VertD = [D]
Load, Pricedividers.pcb
,*****************************************

set, #bottomdrw=5
load, lowerspannercount basedrawers.pcb



,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
set, (LMR>0):#lowerspannercount=2
Load, Pricefixedshelves.pcb
,*****************************************











,************* OTHER PARTS ***************
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,             w, h,          #BackPrintOrderNumber,              
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
,Calculates a Drawer cost
Set, #DrawerOpeningWidth = [W-LS-RS]/2
Set, #DrawerOpeningHeight = DH1
Set, #DrawerFrontWidth = D1W/2
Set, #DrawerFrontHeight = D1H

Set, (#DrawerFrontHeight=0):#drawerfront1=0:#drawerfront1=1
set, #nodrawerbox=0
Set, (D1DR>0):#drawernumber=1:#drawernumber=0
Set, ((Opt=#OptDrw1NDB)&(#drawernumber=1)):#nodrawerbox=1
set, #swapglides=0
Set, ((Opt=#OptDrw1SG)&(#drawernumber=1)&((#ExtraUnitText8 = "*under*")|(#ExtraUnitText8 = "*push*")|(#ExtraUnitText8 = "*inset*"))):#swapglides=1
Load, (#nodrawerbox=0)&(D1HG=0)&(D1H>0)&(D1T=3):E-Drawer Cost.Pcb

,Calculates a Drawer cost
Set, #DrawerOpeningWidth = [W-LS-RS]/2
Set, #DrawerOpeningHeight = DH2
Set, #DrawerFrontWidth = D2W
Set, #DrawerFrontHeight = D2H

Set, (#DrawerFrontHeight=0):#drawerfront1=0:#drawerfront1=1
set, #nodrawerbox=0
Set, (D2DR>0):#drawernumber=1:#drawernumber=0
Set, ((Opt=#OptDrw2NDB)&(#drawernumber=2)):#nodrawerbox=1
set, #swapglides=0
Set, ((Opt=#OptDrw2SG)&(#drawernumber=2)&((#ExtraUnitText8 = "*under*")|(#ExtraUnitText8 = "*push*")|(#ExtraUnitText8 = "*inset*"))):#swapglides=1
Load, (#nodrawerbox=0)&(D2HG=0)&(D2H>0)&(D2T=3):E-Drawer Cost.Pcb

,Calculates a Drawer cost
