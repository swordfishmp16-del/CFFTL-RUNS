,Set Item Costs by Size Increaments



Load, GetMaterialCostGroup.Pcb



,Set,#UsePanelTouchingWallCost=0

,Set,#countloadsforsides=1
,Set,#Totalcountloadsforsides=[#Totalcountloadsforsides+#countloadsforsides]

,Set,(ul=1)&(LS>0)&(#Totalcountloadsforsides=1):#UsePanelTouchingWallCost=#PanelTouchingWallCost

,Set,(#Totalcountloadsforsides=2):#UsePanelTouchingWallCost=0
,Set,(ur=1)&(RS>0)&(#Totalcountloadsforsides=2):#UsePanelTouchingWallCost=#PanelTouchingWallCost


,Set the Cost of Each Type of Vertical
,Change below requested LA CF 7-17-14 Edgeband multiplier
,Set, #CostOfSide =  [((#CostOfVertical + #CostAddedToSides)*#MaterialCostGroup)*#EdgeBandCostGroup]

,Change below requested LA CF 8-27-14 Edgeband multiplier
,Set, #CostOfSide =  [((#CostOfVertical + #CostAddedToSides)*#MaterialCostGroup)+((#CostOfVertical*#EdgeBandCostGroup)-#CostOfVertical)]
,*****Changed 3/2018 Added finish to material selection
,Set, #CostOfSide =  [((#CostOfVertical + #CostAddedToSides)*#MaterialCostGroup)+((#CostOfVertical*#EdgeBandCostGroup))+((#CostOfVertical*#FinishCostGroup))]
,*****
Set, (#edgebyfoot=no): #CostOfSide =  [((#CostOfVertical + #CostAddedToSides)*#MaterialCostGroup)+((#CostOfVertical*#EdgeBandCostGroup))]
Set, (#edgebyfoot=yes): #CostOfSide = [((#CostOfVertical + #CostAddedToSides)*#MaterialCostGroup)+(((H/12)*#EdgeBandCostGroup))]
set, #costofside=[#costofside*#universalupcharge]
,leave file here
End 






,Calculating subtotals
Set,#MaterialCostGroup=0

Set,(#UnitMaterial = "#MaterialName1"):#MaterialCostGroup=#DetailedMaterialCostFactor1
