      DisplaySet, #ShelfCost3BB =396*#shelfpricemultiplier,                   Cost of a Shelf   (up to #ShelfDepthB" deep)   by   (up to #ShelfLength3BB" long), ShelfLengthDepth.Bmp
      Set, (#ShelfWidth>#ShelfLength2BB)&(#ShelfWidth<=#ShelfLength3BB) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #CostOfHorizontal = #ShelfCost3BB , Set the Cost of This Shelf
      ,Set, (#ShelfWidth>#ShelfLength2B)&(#ShelfWidth<=#ShelfLength3B) & (#ShelfDepth>#ShelfDepthA)&(#ShelfDepth<=#ShelfDepthB): #addshelf=14, Shelf count
      }

    
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  }


  




  Do,  (#NumShelfDepth>2):1
  {
