,DisplaySet, #ShelfCostLS=35,Upcharge for L and angle cut Shelf


,Set,#Shelfcostfor16moredeep=#Shelfcostfor16lessdeep,Cost of L Shelf 16 plus deep cost

,Set, #ShelfCostLS =0
,Do,  (rccd>0):1
,  {
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    
    
   
 ,   Do, (rccd>0):1
 ,     {

 ,     Set, #ShelfCostLS =#Shelfcostfor16lessdeep,                   Cost of L Shelf 12 or 16 deep
 ,     Set, (1=1): #CostOfHorizontal = #ShelfCostLS ,Set the Cost of This Shelf
 ,     }

 ,   Do, (rccd>16):1
  ,    {
  ,    set, #ShelfCostLS =#Shelfcostfor16moredeep,                   Cost of L Shelf 12 or 16 deep
,      Set, (1=1): #CostOfHorizontal = #ShelfCostLS ,Set the Cost of This Shelf
  ,    }

,}


,**
,**
,******************************* Shelf Hardware Costs ************************************
DisplaySet, #CostAddedToFixedShelves =0,          1.   Cost added to each Fixed Shelves for hardware.
DisplaySet, #CostAddedToAdjustableShelves =0,          2.   Cost added to each Adjustable Shelves for hardware.
'DisplaySet, #CostAddedToShoeShelves =8,          3.   Cost added to each Shoe Shelf for rail.

,Set the Cost of Each Type of Shelf****See Getmaterialcostshelf****
,Set, #CostOfTopShelf = [(#CostOfHorizontal + #CostAddedToFixedShelves + #costforspecialcuts)]
,Set, #CostOfMiddleShelf = [(#CostOfHorizontal + #CostAddedToFixedShelves + #costforspecialcuts)]
,Set, #CostOfBottomShelf = [(#CostOfHorizontal + #CostAddedToFixedShelves + #costforspecialcuts)]
,Set, #CostOfAdjustableShelf = [(#CostOfHorizontal + #CostAddedToAdjustableShelves + #costforspecialcuts)]
,Set, #CostOfCubbyShelf = [(#CostOfHorizontal + #CostAddedToAdjustableShelves +#costforspecialcuts)]
,Set, #CostOfShoeShelf = [(#CostOfHorizontal + #ShoeFenceCostGroup + #costforspecialcuts)]




,KF Added
,Load,GetMaterialCostAdjShelf.pcb



,Calculates the Name of All Verticals
,Load,(#UsePartNames=No): H-HorizontalNames.Pcb



