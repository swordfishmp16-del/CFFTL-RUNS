      Set, (#ShelfWidth>#ShelfLength2CB)&(#ShelfWidth<=#ShelfLength3CB) & (#ShelfDepth>#ShelfDepthB)&(#ShelfDepth<=#ShelfDepthC): #CostOfHorizontal = #ShelfCost3CB , Set the Cost of This Shelf
      ,Set, (#ShelfWidth>#ShelfLength2C)&(#ShelfWidth<=#ShelfLength3C) & (#ShelfDepth>#ShelfDepthB)&(#ShelfDepth<=#ShelfDepthC): #CostOfHorizontal = #addshelf=15, shelf count
      }

    
    ,**++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  }


 




