,CF angled shelf Right and Door 
,Calculates the price for each part

,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, PriceCornersidesangleR.pcb 
,*****************************************



,*********** All SHELVES ***********
Set, #ShelfWidth = [(W-LS)]
Set, #ShelfDepth = [(D-RS)]
load, Pricecornershelves.pcb      
,*****************************************

,************* OTHER PARTS ***************            
Price, (K>0):1,    #KickName,               #CostOfKick,             (((W-LCCD)^2)+((D-RCCD)^2))^(1/2) , K,        #KickPrintOrderNumber,              
,*****************************************


,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




