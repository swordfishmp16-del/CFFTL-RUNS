,Set Item Costs by Size Increaments


Set, #stopxxafterprice=1
,Calculating subtotals
Do,(#Number>0):1
{
Set,#Cabtotalstd$ = [#Cabtotalstd$ + (#Cost*#Number)]
Set,#Cabtotal = [#Cabtotal + (#Cost*#Number*1.#notusedheredesignermarkup)]
Set,#Subtotalstd$ = [#Subtotalstd$ + (#Cost*#Number)]
Set,#Subtotal = [#Subtotal + (#Cost*#Number*1.#notusedheredesignermarkup)]
}
Do, (#stopfinalOK<>1):1
{

Do,(#RoomNum = 1):1
{

Set,#Room1Subtotal = [#Room1Subtotal + (#Cost*#Number*1.#notusedheredesignermarkup)]

Do,(#name<>"RM*")|((#name="RM*")&(#name="*Door"))|((#name="RM*")&(#name="*Drfrt"))|((#name="RM*")&(#name="*Back*")):1
{
set, #stopafterprice=3
Set,#Room1Material = <#UnitMaterialname>
Set,#Room1Materialcostgroup = <#Materialcostgroup>


Set, #Room1ContrastMaterial= <#ContrastMaterialname>
Set, #Room1ContrastMaterialcostgroup=<#ContrastMaterialcostgroup>

Set,#Room1EdgeBandingType= <#EdgeBandingType>

Set,#Room1ClosetRodType= <#ClosetRodType>
Set, #Room1ClosetRodcount= [#Room1ClosetRodcount+#stdrodcnt]
Set, (#name="#ClosetPoleName")&(opt=#CutToFitoptnum):#addtorodlength=#Wallwidthadj:#addtorodlength=0
Set, (#name="#ClosetPoleName"):#Room1ClosetRodlengthcount= [#Room1ClosetRodlengthcount+#shelfwidth+#addtorodlength]


Set,#Room1DoorDrawerType= <#DoorDrawerType>
Set,#Room1DoorDrawerFinishingType= <#DoorDrawerFinishingType>
Set,(#presetinsertcost=0):#Room1DoorDrawerInsertType= <#DoorDrawerInsertType>
set,(#name<>"*hinge*"):#Room1Basicdoorcost=[#Room1Basicdoorcost+#Basicdoorcost]
set,(#name<>"*hinge*"):#Room1DoorCost=[#Room1DoorCost+#costofdoor] 


Do,(#presetinsertcost=1):1
{
Set, (#DoorDrawerInsertType="#DoorDrawerInsertMirror"):#RM1otherinsert1=<#DoorDrawerInsertType>
Set, (#DoorDrawerInsertType="#DoorDrawerInsertBevMirror"):#RM1otherinsert2=<#DoorDrawerInsertType>
Set, (#DoorDrawerInsertType="#DoorDrawerInsertSpeaker"):#RM1otherinsert3=<#DoorDrawerInsertType>
Set, (#DoorDrawerInsertType="#DoorDrawerInsertSmoke"):#RM1otherinsert4=<#DoorDrawerInsertType>
Set, (#DoorDrawerInsertType="#DoorDrawerInsertFrost"):#RM1otherinsert5=<#DoorDrawerInsertType>
}
set, (#Name="flatCFMirror*"):#RM1otherinsert6=Applied Mirror
set, (#Name="flatCFMold*"):#RM1otherinsert7=Applied Molding


Set,#Room1CrownMoldingType=<#CrownMoldingType>
Set, #Room1CrownMoldingCostGroup=<#CrownMoldingTypeCostGroup>

Set,#Room1BaseType= <#BaseType>
Set,(#Room1BaseType<>"#BaseType0")&(#Room1BaseType<>"#BaseType00"):#Room1basecostgroup=<#BaseTypeCostGroup>:#Room1basecostgroup=0

Set,(#Toestopcount>0):#Room1ShoeFenceType= <#ShoeFenceType>
set,(#Toestopcount>0):#room1Shoefencefinish=<#shoefencefinish>
Set,(#Toestopcount>0):#Room1Shoefencecount = [#Room1Shoefencecount+#Toestopcount]

Set,#Room1BackType = <#BackType> 
Set,(#name="*Back-*")&(#specialback<>1):#room1hasbacking=1
set,(#specialback=1):#Room1Specialback=<#specialback>
Set,(#name="*Back-None*")&(#specialback=1):#room1needbackingselected=1

set, #stopafterprice=0
,Drawer glides
Set,#Room1BoxDrawertype= <#BoxDrawertype>
Set,#Room1BoxGlideTag= <#drawerboxglidetag>
Do,(#drawernumber>0)&(#name<>"*add*"):1
  {
set,#Room1BoxDrawercount=[#Room1BoxDrawercount+1]
Set,(#swapglides=1):#Room1Drawerswitchcount=[#Room1Drawerswitchcount+1]
}
Set,#Room1Glidecount=[(#Room1BoxDrawercount-#Room1Drawerswitchcount)]
Set, #Room1Switchglidecount=[#Room1Drawerswitchcount ]

Do,(#Room1BoxDrawertype<>"*Melamine*")&(#Room1BoxDrawertype<>"*Veneer*"):1
{
Len, #tagSize, #Room1BoxGlideTag
Len, #size,#Room1BoxDrawertype
Left,#Room1boxname, #Size-#tagsize, #Room1BoxDrawertype
}

,Sliding Shelf Glides
Set,(#slidingshelf=1):#Room1SSGlidecount=[#Room1SSGlidecount+1]
Set,(#UMslidingshelf=1):#Room1SSUMGlidecount=[#Room1SSUMGlidecount+1]

,Pullout Glides
Set,(#Pullout=1):#Room1POGlidecount=[#Room1POGlidecount+1]
Set,(#UMPullout=1):#Room1POUMGlidecount=[#Room1POUMGlidecount+1]

,Caddy or Vertical Drawer Glides
Set,(#VDunit=1):#Room1VDGlidecount=[#Room1VDGlidecount+1]
Set,(#VD2unit=1):#Room1VD2Glidecount=[#Room1VD2Glidecount+1]
Set, #Room1VDTotalGlidecount=[#Room1VDGlidecount+#Room1VD2Glidecount]

