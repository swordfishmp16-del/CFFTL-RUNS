Set,(#ClosetHardwaretype<>"None"): #Room1HandlePN=<#DoorHandlePN>
Set, (#ClosetHardwaretype<>"None"):#Room1KnobPN=<#DoorKnobPN>

Set,#Room1notchdepth= <#notchdepth>
Set,#Room1notchheight= <#notchheight>
Set, #Room1notchdepthhasshoe=<#notchdepthhasshoe>
}

Set,(#Stdhingeadd>0):#Room1StdDoorHingeCount = [#Room1StdDoorHingeCount+(#StdHingeadd)]
Set,(#Overlayhingeadd>0):#Room1OverlayDoorHingeCount = [#Room1OverlayDoorHingeCount+(#OverlayHingeadd)]
Set,(#Tophingeadd>0):#Room1TopDoorHingeCount=[#Room1TopDoorHingeCount+(#Tophingeadd)]
Set,(#Bottomhingeadd>0):#Room1BottomDoorHingeCount=[#Room1BottomDoorHingeCount+(#Bottomhingeadd)]
Set, #Tophingeadd=0
set, #Bottomhingeadd=0
Set, #Overlayhingeadd=0
Set, #Stdhingeadd=0
,These are multi-piece per unit options, see cfcountoptionroom1.pcb for others.
Set,#Room1dogearpanelcount=[#Room1dogearpanelcount+#dogearadd]
Set,#Room1Cchannel2shelfcount=[#Room1Cchannel2shelfcount+#addcchannel2]
Set,#Room1Cchannel1shelfcount=[#Room1Cchannel1shelfcount+#addcchannel1]
Set,((#addcchannel1>0)|(#addcchannel2>0))&(opt=#CutToFitoptnum):#addtocchannellength=#Wallwidthadj:#addtocchannellength=0
Set,(#addcchannel1>0)|(#addcchannel2>0):#Room1Cchannelcount=[#Room1Cchannelcount+#addcchannel1+(#addcchannel2*2)]
set,(#addcchannel1>0)|(#addcchannel2>0):#Room1Cchannellengthcount=[#Room1Cchannellengthcount+((#shelfwidth+#addtocchannellength)*#addcchannel2*2)+((#shelfwidth+#addtocchannellength)*#addcchannel1)]
Set,#Room1thickadjshelfcount=[#Room1thickadjshelfcount+#addadjtothickshelf]
Set,#Room1adjtoeuroshelfcount=[#Room1adjtoeuroshelfcount+#addadjtoeuroshelf]
Set,#Room1frontlipshelfcount=[#Room1frontlipshelfcount+#addfrontlips]
Set,#Room1ledFpanelcount=[#Room1ledFpanelcount+#ledFpaneladd]
Set,#Room1ledHpanelcount=[#Room1ledHpanelcount+#ledHpaneladd]
Set,#Room1ledshelfcount=[#Room1ledshelfcount+#addledshelf]
Set,#Room1Routedpuckshelfcount=[#Room1Routedpuckshelfcount+#addpuckshelf]
Set,#Room1Surfacepuckshelfcount=[#Room1Surfacepuckshelfcount+#addSpuckshelf]

Set,#Room1task12inshelfcount=[#Room1Task12inshelfcount+#add12intaskshelf]
Set,#Room1task24inshelfcount=[#Room1Task24inshelfcount+#add24intaskshelf]
Set,#Room1task30inshelfcount=[#Room1Task30inshelfcount+#add30intaskshelf]
Set,#Room1task36inshelfcount=[#Room1Task36inshelfcount+#add36intaskshelf]
Set,#Room1task42inshelfcount=[#Room1Task42inshelfcount+#add42intaskshelf]
Set,#Room1task45inshelfcount=[#Room1Task45inshelfcount+#add45intaskshelf]

Set,#Room1EBTopofPanelcount=[#Room1EBTopofPanelcount+#TopEBadd]
Set,#Room1EBBackofPanelcount=[#Room1EBBackofPanelcount+#BackEBadd]
Set,#Room1RWshelfcount=[#Room1RWshelfcount+#addRWShelfnotch]


Set,#Room1Wbusbarcount=[#Room1Wbusbarcount+#wBusbaradd]
Set,#Room1WLEDshelfcount=[#Room1WLEDshelfcount+#Waddledshelf] 


load, cfafterpriceroom1options.pcb


}
,end Room1


