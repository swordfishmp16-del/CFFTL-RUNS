Do,(#UnitFileName="PullDownRodCHR.cab"):1
{
Set, #Pulldownrodfinish=CHR
Set, #PulldownRodPN=Invalid Size
Set, ((W>=21.25)&(W<=26)):#PulldownrodPN=805.31.201
Set, ((W>26)&(W<=35.0625)):#PulldownrodPN=805.31.202 
Set, ((W>35.0625)&(W<=47.625)):#PulldownrodPN=805.31.203 
}
