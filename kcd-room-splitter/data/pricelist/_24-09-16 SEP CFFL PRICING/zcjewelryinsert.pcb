,******** ALL JEWELRY INSERTS ************
Price, 1,   RM#Roomnum #Name-#Jewelryinserttype-#insertsize,      #CostofJewelryInsert*#universalupcharge,             W, d,          #ValetrodPrintOrderNumber,     
