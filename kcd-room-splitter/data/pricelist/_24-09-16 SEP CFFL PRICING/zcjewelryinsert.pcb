,Determine Cost of Jewelry Insert



,DisplaySet,#ChargeOversizeinsertupsizew=24, ---------------------- Max width for no-upcharge (wider will be charged)?
,DisplaySet,#ChargeOversizeinsertupsized=24, ---------------------- Max width for no-upcharge (wider will be charged)?
   ,DisplaySet,#ChargeOversizeinsertpercent= .5, ---------------------- Percent to upcharge for oversize custom insert.


load, V-jewelryinsertcost.pcb
Set, #upcharge = 1
Set, (w>#ChargeOversizeinsertupsizew):#upcharge=[1+#ChargeOversizeinsertpercentw]
Set, (w>#ChargeOversizeinsertupsizew):#insertsize=over-size width:#insertsize=std-size
Set, (d>#ChargeOversizeinsertupsized):#upcharge=[1+#ChargeOversizeinsertpercentd]
Set, (d>#ChargeOversizeinsertupsized):#insertsize=over-size depth
Set, ((w>#ChargeOversizeinsertupsizew)&(d>#ChargeOversizeinsertupsized)):#upcharge=[1+#ChargeOversizeinsertpercentw+#ChargeOversizeinsertpercentd]
Set, ((w>#ChargeOversizeinsertupsizew)&(d>#ChargeOversizeinsertupsized)):#insertsize=over-size width and depth

Do,(#UnitFileName="jewelryinsertVL.cab"):1
{
Set, #CostofJewelryInsert = #Velvetlinercost*#Upcharge
Set, #Jewelryinserttype=Bottom 
}
Do,(#UnitFileName="JewelryinsertPFA.cab"):1
{
Set, #CostofJewelryInsert = #PrefabAcost
Set, #Jewelryinserttype= #PrefabAname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFB.cab"):1
{
Set, #CostofJewelryInsert = #PrefabBcost
Set, #Jewelryinserttype= #PrefabBname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFC.cab"):1
{
Set, #CostofJewelryInsert = #PrefabCcost
Set, #Jewelryinserttype= #PrefabCname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFD.cab"):1
{
Set, #CostofJewelryInsert = #PrefabDcost
Set, #Jewelryinserttype= #PrefabDname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFE.cab"):1
{
Set, #CostofJewelryInsert = #PrefabEcost
Set, #Jewelryinserttype= #PrefabEname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFF.cab"):1
{
Set, #CostofJewelryInsert = #PrefabFcost
Set, #Jewelryinserttype= #PrefabFname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFG.cab"):1
{
Set, #CostofJewelryInsert = #PrefabGcost
Set, #Jewelryinserttype= #PrefabGname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFH.cab"):1
{
Set, #CostofJewelryInsert = #PrefabHcost
Set, #Jewelryinserttype= #PrefabHname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFI.cab"):1
{
Set, #CostofJewelryInsert = #PrefabIcost
Set, #Jewelryinserttype= #PrefabIname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFX.cab"):1
{
Set, #CostofJewelryInsert = #PrefabXcost
Set, #Jewelryinserttype= #PrefabXname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFY.cab"):1
{
Set, #CostofJewelryInsert = #PrefabYcost
Set, #Jewelryinserttype= #PrefabYname
set, #insertsize=one-size
}
Do,(#UnitFileName="JewelryinsertPFZ.cab"):1
{
Set, #CostofJewelryInsert = #PrefabZcost
Set, #Jewelryinserttype= #PrefabZname
set, #insertsize=one-size
}
Do,(#UnitFileName="Jewelryinsert1.cab"):1
{
Set, #CostofJewelryInsert = #Custom1cost*#Upcharge
Set, #Jewelryinserttype= #Custom1name
}
Do,(#UnitFileName="Jewelryinsert2.cab"):1
{
Set, #CostofJewelryInsert = #Custom2cost*#Upcharge
Set, #Jewelryinserttype= #Custom2name
}
Do,(#UnitFileName="Jewelryinsert3.cab"):1
{
Set, #CostofJewelryInsert = #Custom3cost*#Upcharge
Set, #Jewelryinserttype= #Custom3name
}
