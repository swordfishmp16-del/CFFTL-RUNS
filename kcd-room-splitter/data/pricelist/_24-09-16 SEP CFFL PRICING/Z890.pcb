,CF Baseboard pricing as selected kick


Load,GetMaterialCostBaseKick.pcb
set, #sectioncount= [W\36]
set,#sectioncountremainder = [#sectioncount % 8]
   set,(#sectioncountremainder<5):#sectioncount = [#sectioncount + 1]
   
,Set,#BoardBaseLengthSub=(W/96)
,Set,#BoardBaseLengthTotal=[(#BoardBaseLengthSub+#BoardBaseLengthTotal)]

,Set,#boardBaseCostSub=(#BoardBaseLengthTotal*#BaseTypeCostGroup)
,Set,#boardBaseTotCost=[#boardBaseTotCost+#boardBaseCostSub]

set, (#costofkick=0):#costofkick=#addkickcost


,******** ALL BASE BOARD **********
,Price, 1,    #DetailBaseName,             #CostOfDetailBase,             w, H,          #DetailBasePrintOrderNumber,    
Price,(#BaseType = "#BaseType0"): 1,      Added room Base Molding - match #KickName,            #sectioncount*#CostOfKick*#Universalupcharge,             H,  W,          #KickPrintOrderNumber,      
Price,(#BaseType <> "#BaseType0"):  1,      Added room Base Molding - Included in Room Base Cost,    ,         H,  W,          #KickPrintOrderNumber,          
 ,Price,  1,      Added room Molding - Included in Room Base Cost,    ,         H,  W,          #KickPrintOrderNumber,          
       
,**********************************
