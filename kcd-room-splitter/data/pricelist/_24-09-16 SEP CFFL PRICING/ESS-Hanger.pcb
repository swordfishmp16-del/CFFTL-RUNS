,Use Grid

set, #stopesspricing=3
,**
,**
,** SET COSTS FOR ESSENTIALS HANGER RAIL and COVER
,** 
,**
,**  
,** COSTS FLEX HARDWARE COMPONENTS
,**
Displayset, #hangrailName=ESS-Hang Rail, 1.0 Name for Essentials Hang Rail
DisplaySet, #hangrailcost=40, 1.1 Cost for Essentials Hang Rail
Displayset, #ESSPNhangrail=290.11.907, 1.2 PN for Essentials Hang Rail
Displayset, #railpiecelength=93, 1.3 Length of Rail Piece
,**
DisplaySet, #hangrailcoverName =ESS-Hang Rail w White Cover, 2.0 Name for Essentials Hang Rail with White Cover
DisplaySet, #hangrailcovercost =(40+15), 2.1 Cost for Essentials Hang Rail with White Cover
DisplaySet, #ESSPNhangrailcover =290.11.907+290.12.790, 2.2 PN for Essentials Hang Rail with White Cover
Displayset, #railcoverpiecelength=93, 2.3 Length of Rail Piece with Cover

,**See option.dat file in Essentials unit library folder
Displayset, #Esspanelhangerleftoption=1,  3.0 Option number for left mounted panel hanger 
Displayset, #Esspanelhangerleftname=Opt-ESS Hanger Hook Left,  3.1 Option number for left mounted panel hanger 
Displayset, #EsspanelhangerleftPN=290.02.721,  3.2 part number for left mounted panel hanger 

Displayset, #Esspanelhangerrightoption=2,  4.0 Option number for right mounted panel hanger 
Displayset, #Esspanelhangerrightname=Opt-ESS Hanger Hook Right,  4.1 Option number for right mounted panel hanger 
Displayset, #EsspanelhangerrightPN=290.02.720,  4.2 part number for right mounted panel hanger 

,**
Displayset, #pricefilleraspanel=No, 5.0 Price the filler as a panel. [Yes;No]
Displayset, #nameforesspanelfiller=Panel Filler, 5.1 Name of Essentials Panel Filler
Do, (#pricefilleraspanel=No):1
{
Displayset, #costofESSpanelfiller=100, 5.2 Cost of Essentials Panel Filler
}
,**

Displayset, #useESScleat=Yes, 6.0 Do you use a cleat for no ESB Essential Units? [Yes;No]
set, #EssentialsCleatcost=0 
set, #essentialscleatHeight=0 
Do, (#useESScleat=Yes):1
{
Displayset, #EssentialsCleatcost=20, 6.1 Cost for Essentials Cleat (if used)
Displayset, #essentialscleatHeight=4, 6.2 Height Essentials Cleat (if used)
}   

