,Not used right now....



,displaySet,#DesignerMarkup=00, Markup - will only be reflected in the room by room report answer 01 for 1 percent



,**

,**
,**   DISCOUNTS See Extra Charge 05 above
,**   This section will help you create a pop-up Question when running your pricing. Create catagories you wish below .05 is 5% less
DisplaySet,#HowManyDiscounts=5,1.1  How many discount catogories would you like? 0 shuts discounts off? [0;1;2;3;4;5]

Skip,(#HowManyDiscounts=0):1
{
   ,**   To have your Discount show up on your printed report Subtotals go to your A-Setup file near the bottom of the page
   ,**   you will see your Extra Subtotals Go to Extra Charge 05 and set do you want to use this extra charge and set it to yes
}


,**
Skip,(#HowManyDiscounts=0):1
{
   DisplaySet, #CustomerTierName =Discount,1.2 --- Customer Discount Question? This will be the pop-question when running pricing
   
   ,**
   Do,(#HowManyDiscounts=1):1
   {
      DisplaySet,#DiscountName1=Discount,1.3 Name of Discount 1
      AskQuestion,#CustomerTier,#DiscountName1,#CustomerTierName
      DisplaySet,#MarkupTier1=0.03,1.4    (Discount 1) #DiscountName1 percentage
   }
   
   Do,(#HowManyDiscounts=2):1
   {
      DisplaySet,#DiscountName1=Discount Special,1.3 Name of Discount 1
      DisplaySet,#DiscountName2=Discount Friends and Family,1.4 Name of Discount 2
      AskQuestion,#CustomerTier,#DiscountName1,#CustomerTierName [#DiscountName1;#DiscountName2]
      DisplaySet,#MarkupTier1=0.1,1.5   (Discount 1) #DiscountName1 percentage
      DisplaySet,#MarkupTier2=0.05,1.6   (Discount 2) #DiscountName2 percentage
   }
   
   Do,(#HowManyDiscounts=3):1
   {
      DisplaySet,#DiscountName1=Discount Special,1.3 Name of Discount 1
      DisplaySet,#DiscountName2=Discount Friends and Family,1.4 Name of Discount 2
      DisplaySet,#DiscountName3=Discount Contractor,1.5 Name of Discount 3
      AskQuestion,#CustomerTier,#DiscountName1,#CustomerTierName [#DiscountName1;#DiscountName2;#DiscountName3]
      DisplaySet,#MarkupTier1=0,1.6   (Discount 1) #DiscountName1 percentage
      DisplaySet,#MarkupTier2=0.05,1.7   (Discount 2) #DiscountName2 percentage
      DisplaySet,#MarkupTier3=0.08,1.8   (Discount 3) #DiscountName3 percentage
   }
   
   Do,(#HowManyDiscounts=4):1
   {
      DisplaySet,#DiscountName1=Discount Special,1.3 Name of Discount 1
      DisplaySet,#DiscountName2=Discount Friends and Family,1.4 Name of Discount 2
      DisplaySet,#DiscountName3=Discount Contractor,1.5 Name of Discount 3
      DisplaySet,#DiscountName4=Discount Educational,1.6 Name of Discount 4
      AskQuestion,#CustomerTier,#DiscountName1,#CustomerTierName [#DiscountName1;#DiscountName2;#DiscountName3;#DiscountName4]
      DisplaySet,#MarkupTier1=0,1.7   (Discount 1) #DiscountName1 percentage
      DisplaySet,#MarkupTier2=0.05,1.8   (Discount 2) #DiscountName2 percentage
      DisplaySet,#MarkupTier3=0.08,1.9   (Discount 3) #DiscountName3 percentage
      DisplaySet,#MarkupTier4=0.12,1.10   (Discount 4) #DiscountName4 percentage
   }
   
   Do,(#HowManyDiscounts=5):1
   {
      DisplaySet,#DiscountName1=Discount 0,1.3 Name of Discount 1
      DisplaySet,#DiscountName2=Discount 2 1/2 %,1.4 Name of Discount 2
      DisplaySet,#DiscountName3=Discount  5 %,1.5 Name of Discount 3
      DisplaySet,#DiscountName4=Discount  7 1/2 %,1.6 Name of Discount 4
      DisplaySet,#DiscountName5=Discount  10 %,1.7 Name of Discount 5
      AskQuestion,#CustomerTier,#DiscountName1,#CustomerTierName [#DiscountName1;#DiscountName2;#DiscountName3;#DiscountName4;#DiscountName5]
      DisplaySet,#MarkupTier1=0,1.8   (Discount 1) #DiscountName1 percentage
      DisplaySet,#MarkupTier2=0.025,1.9   (Discount 2) #DiscountName2 percentage
      DisplaySet,#MarkupTier3=0.05,1.10   (Discount 3) #DiscountName3 percentage
      DisplaySet,#MarkupTier4=0.075,1.11   (Discount 4) #DiscountName4 percentage
      DisplaySet,#MarkupTier5=0.10,1.12   (Discount 5) #DiscountName5 percentage
   }
   
   Set,(#CustomerTier="#DiscountName1"):#JobDiscount=#MarkupTier1
   Set,(#CustomerTier="#DiscountName2"):#JobDiscount=#MarkupTier2
   Set,(#CustomerTier="#DiscountName3"):#JobDiscount=#MarkupTier3
   Set,(#CustomerTier="#DiscountName4"):#JobDiscount=#MarkupTier4
   Set,(#CustomerTier="#DiscountName5"):#JobDiscount=#MarkupTier5
   
   Set,(#CustomerTier="#DiscountName1"):#DiscountName=#DiscountName1
   Set,(#CustomerTier="#DiscountName2"):#DiscountName=#DiscountName2
   Set,(#CustomerTier="#DiscountName3"):#DiscountName=#DiscountName3
   Set,(#CustomerTier="#DiscountName4"):#DiscountName=#DiscountName4
   Set,(#CustomerTier="#DiscountName5"):#DiscountName=#DiscountName5
}

,**
,**  FEE CHOICES See Extra Charge 03 above
,**   This section will help you create a pop-up Question when running your pricing. Create catagories you wish below


DisplaySet,#HowManyFees=1,1.13  How many extra fees do you wish to have? 0 = Skip question [0;1;2;3;4;5;6;7;8]
,**
Skip,(#HowManyFees=0):1
{
   DisplaySet,#FeeNameQuestion =Extra Charge,1.14 --- Extra Fee Question? This will be the pop-question when running pricing
   
   Do,(#HowManyFees=1):1
   {
      DisplaySet,#FeeName1=High Rise Fee,1.15 Name of Fee 1
      AskQuestion,#FeeSelection,#FeeName1,#FeeNameQuestion [#FeeName1]
      DisplaySet,#FeeCost1=250,1.16   (Flat Fee 1) #FeeName1 Cost
   }
   
   Do,(#HowManyFees=2):1
   {
      DisplaySet,#FeeName1=Doors and Drawer Faces special,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Drawer Box Special,1.16 Name of Fee 2
      AskQuestion,#FeeSelection,#FeeName1,#FeeNameQuestion [#FeeName1;#FeeName2]
      DisplaySet,#FeeCost1=0,1.17   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=0,1.18   (Flat Fee 2) #FeeName2 Cost
   }
   
   Do,(#HowManyFees=3):1
   {
      DisplaySet,#FeeName1=No Extra Fee,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Parking,1.16 Name of Fee 2
      DisplaySet,#FeeName3=Special Labor  ,1.17 Name of Fee 3
      AskQuestion,#FeeSelection,#FeeName1,#FeeNameQuestion [#FeeName1;#FeeName2;#FeeName3]
      DisplaySet,#FeeCost1=0,1.18   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=0,1.19   (Flat Fee 2) #FeeName2 Cost
      DisplaySet,#FeeCost3=0,1.20   (Flat Fee 3) #FeeName3 Cost
   }
   
   Do,(#HowManyFees=4):1
   {
      DisplaySet,#FeeName1=No Extra Fee,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Parking,1.16 Name of Fee 2
      DisplaySet,#FeeName3=Special Labor  ,1.17 Name of Fee 3
      DisplaySet,#FeeName4=High Rise Fee  ,1.18 Name of Fee 4
      AskQuestion,#FeeSelection,#FeeName1,#FeeNameQuestion [#FeeName1;#FeeName2;#FeeName3;#FeeName4]
      DisplaySet,#FeeCost1=0,1.19   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=10,1.20   (Flat Fee 2) #FeeName2 Cost
      DisplaySet,#FeeCost3=20,1.21   (Flat Fee 3) #FeeName3 Cost
      DisplaySet,#FeeCost4=30,1.22   (Flat Fee 4) #FeeName4 Cost
   }
   
   Do,(#HowManyFees=5):1
   {
      DisplaySet,#FeeName1=No Extra Fee,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Parking,1.16 Name of Fee 2
      DisplaySet,#FeeName3=Special Labor  ,1.17 Name of Fee 3
      DisplaySet,#FeeName4=High Rise Fee  ,1.18 Name of Fee 4
      DisplaySet,#FeeName5=Parking - Special Labor  ,1.19 Name of Fee 5
      AskQuestion,#FeeSelection,#FeeName1,#FeeNameQuestion [#FeeName1;#FeeName2;#FeeName3;#FeeName4;#FeeName5]
      DisplaySet,#FeeCost1=0,1.20   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=10,1.21   (Flat Fee 2) #FeeName2 Cost
      DisplaySet,#FeeCost3=20,1.22   (Flat Fee 3) #FeeName3 Cost
      DisplaySet,#FeeCost4=30,1.23   (Flat Fee 4) #FeeName4 Cost
      DisplaySet,#FeeCost5=60,1.24   (Flat Fee 5) #FeeName5 Cost
   }
   
   Do,(#HowManyFees=6):1
   {
      DisplaySet,#FeeName1=No Extra Fee,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Parking,1.16 Name of Fee 2
      DisplaySet,#FeeName3=Special Labor  ,1.17 Name of Fee 3
