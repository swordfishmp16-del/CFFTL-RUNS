      DisplaySet,#FeeCost1=0,1.21   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=10,1.22   (Flat Fee 2) #FeeName2 Cost
      DisplaySet,#FeeCost3=20,1.23   (Flat Fee 3) #FeeName3 Cost
      DisplaySet,#FeeCost4=30,1.24   (Flat Fee 4) #FeeName4 Cost
      DisplaySet,#FeeCost5=60,1.25   (Flat Fee 5) #FeeName5 Cost
      DisplaySet,#FeeCost6=70,1.26   (Flat Fee 6) #FeeName6 Cost
   }
   
   Do,(#HowManyFees=7):1
   {
      DisplaySet,#FeeName1=No Extra Fee,1.15 Name of Fee 1
      DisplaySet,#FeeName2=Parking,1.16 Name of Fee 2
      DisplaySet,#FeeName3=Special Labor  ,1.17 Name of Fee 3
