      DisplaySet,#FeeCost1=0,1.22   (Flat Fee 1) #FeeName1 Cost
      DisplaySet,#FeeCost2=10,1.23   (Flat Fee 2) #FeeName2 Cost
      DisplaySet,#FeeCost3=20,1.24   (Flat Fee 3) #FeeName3 Cost
      DisplaySet,#FeeCost4=30,1.25   (Flat Fee 4) #FeeName4 Cost
