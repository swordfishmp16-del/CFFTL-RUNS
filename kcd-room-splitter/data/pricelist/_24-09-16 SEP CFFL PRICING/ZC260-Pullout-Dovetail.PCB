
,CF Library - Closet Pieces
,******** ALL PULLOUTS Dovetail *************

Set, #PulloutOpeningWidth = W
Set, #ShelfWidth = [(W)]     
Set, #ShelfDepth = [(D)]

Set, #shelfTH=#ShelfThickA

Set, #W = [(#PulloutOpeningWidth/NDiv) -1]
Set, #H = H
Set, #D = [D]


Set, #H = {#H}




Do, (#traypricemethod="Shelf Cost Plus"):1
{
Set, #PulloutOpeningWidth = W
Set, #ShelfWidth = [(W)]     
Set, #ShelfDepth = [(D)]
set, #Tempshelfcount=1
Set, #shelfTH=#ShelfThickA
Load, C-Shelf Cost.pcb
set, #displaycost=#CostofAdjustableShelf

,**
'Price Pullout Box

Set, #W = [(#PulloutOpeningWidth/NDiv) -1]
Set, #H = H
Set, #D = [D]


Set, #H = {#H}

, #### SET PULLOUT COST BELOW #######

Price, (#Unitfilename<>"*Under*")&(#Unitfilename<>"*finger*"):1, RM#Roomnum #H" Pullout Dovetail Tray,   (#Costfortray+#dovetailtraycost+#Displaycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Under*")&(#Unitfilename<>"*finger*"):1, RM#Roomnum #H" Under Mt Pullout Dovetail Tray,   (#Costfortray+#dovetailtraycost++#Displaycost#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,

Price, (#Unitfilename<>"*Under*")&(#Unitfilename="*finger*"):1, RM#Roomnum #H" Pullout Dovetail w/Fingerpull Tray,   (#Costfortray+#dovetailfingertraycost+#Displaycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Under*")&(#Unitfilename="*finger*"):1, RM#Roomnum #H" Under Mt Pullout Dovetail w/Fingerpull Tray,   (#Costfortray+#dovetailfingertraycost+#Displaycost#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,
}

Do, (#traypricemethod="Fixed Style Cost"):1
{

Price, (#Unitfilename<>"*Under*")&(#Unitfilename<>"*finger*"):1, RM#Roomnum #H" Pullout Dovetail Tray,   (#dovetailtraycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Under*")&(#Unitfilename<>"*finger*"):1, RM#Roomnum #H" Under Mt Pullout Dovetail Tray,   (#dovetailtraycost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,

Price, (#Unitfilename<>"*Under*")&(#Unitfilename="*finger*"):1, RM#Roomnum #H" Pullout Dovetail w/Fingerpull Tray,   (#dovetailfingertraycost),   D,   W,   #PulloutPrintOrderNumber,
Price, (#Unitfilename="*Under*")&(#Unitfilename="*finger*"):1, RM#Roomnum #H" Under Mt Pullout Dovetail w/Fingerpull Tray,   (#dovetailfingertraycost+#undermttraycost),   D,   W,   #PulloutPrintOrderNumber,
}




