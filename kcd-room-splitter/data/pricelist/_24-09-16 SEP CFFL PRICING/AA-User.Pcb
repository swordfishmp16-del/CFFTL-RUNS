,Use Grid
,**
,**   USER FILE for Pricing
,**
,**   The Names you enter below must match what you have in your Set Unit Info Section to work
,**

Set,#MaterialCostGroup=0

Set,#Totalcountloadsforsides=0
set,#shoeFencecostgroup=0



Set,#UnitMaterial=#ExtraUnitText1
Set,#UnitMaterialName=#ExtraUnitText1

Set,#DoorDrawerType=#ExtraUnitText2

Set,#EdgeBandingType=#ExtraUnitText3


Set,#ContrastMaterial=#ExtraUnitText12
Set,#ContrastMaterialName=#ExtraUnitText12
Set,("ContrastmaterialName <> "None 1.00"):#use2ndmaterial=1:#Use2ndmaterial=0


Set,#ClosetRodType=#ExtraUnitText4

Set,#BaseType=#ExtraUnitText5

Set,#CrownMoldingType=#ExtraUnitText6

Set,#BackType=#ExtraUnitText7

Set,#BoxDrawertype=#ExtraUnitText8

Set,#notchDepth=#ExtraUnitText9

Set,#notchheight=#ExtraUnitText10

set,#ShoeFenceType = None

Set,#DoorDrawerFinishingType=#ExtraUnitText14

set,#DoorDrawerInsertType = #ExtraUnitText15



,**  SECTION 1  Miscellaneous (Panel touching wall with Pop Up Questions for Discounts and Fees)
,**  SECTION 2  Door and Drawer Front Setup ( Set in QUICK LOAD under D-DOOR COST.PCB bottom right corner of your screen )
,**  SECTION 3  Edge Banding
,**  SECTION 4  Rod Cost
,**  SECTION 5  Base Cost (Kick)
,**  SECTION 6  Crown Molding Cost
,**  SECTION 7  Back Cost
,**  SECTION 8  Fluted Pilaster Cost
,**  SECTION 9  Drawer Box Cost ( Set in QUICK LOAD under E-DRAWER COST.PCB bottom right corner of your screen )
,**  SECTION 10 Handle and Knob Cost
,**  SECTION 11 Finishing Cost
,**  SECTION 12 Shoe Fence Cost
,**  SECTION 13 Door/Drawer Finishing Cost
,**  SECTION 14 Door/Drawer Insert Cost
,**  SECTION 15 Miscellaneous Cost and Shelf Options



,Hanknob not setup yet this variable below could be wrong
Set,#HanKnobHardware=#ExtraUnitText11

,This was added below to work on xxafter.prt room subtotals
Set,#ClosetHardwaretype=#ExtraUnitText11



,   **
,Set,#IncludequestionBack=no

,Set, #IncludeBackName =Include Backs Yes or No?, --- Include Backs Question?
,DisplaySet, #IncludeBacksName =Include Backs Yes or No?, --- Include Backs Question?
,AskQuestion,#IncludeBacksYN,No,#IncludeBacksName  [Yes;No]
Set,#IncludeBacks=bkyn
,Set,#IncludeBacks=Yes

,Set,(#IncludeBacksYN="No"):#IncludeBacks=No

,**
DisplaySet,#PanelTouchingWallCost=17,1. Extra cost for panel touching wall

,**

,load, I-Popupquestions.pcb

