,Set,#UseCtopFootageFactor=square,Do you price your Counter Tops by Lineal or Square Ft? [lineal;square]
,DisplaySet,#UseCtopFootageFactor=  Lineal,Do you price your Counter Tops by Lineal or Square Ft? [Lineal;square]
,Set,(#UseCtopFootageFactor="square");#CtopFormulaForFootage=((((w+ctl+ctr)*(d+ctf+ctb)*Num))/144)
,Set,(#UseCtopFootageFactor="lineal");#CtopFormulaForFootage=((((w+ctl+ctr)*Num))/12)


,Creates Counter Top total job footage
,Set,(ct>0);#CTopFootage = [#CTopFootage + #CtopFormulaForFootage]
Set,#CTopFootage = 0



