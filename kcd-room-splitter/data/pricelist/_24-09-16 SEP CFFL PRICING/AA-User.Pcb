Set, #CTopSq$temp =19.15,* COUNTER TOP ---------- Square foot/meter cost


,                       ######  BACKSPLASH COST ######

Set,#Subtotal11Name=4" Backsplash ,4" Backsplash Name (this is what prints out on the report)
Set, #Splash4LF$temp =2.25  ,4" BACKSPLASH -------- lineal foot/meter cost
,**
Set,#Subtotal12Name=Full Backsplash ,Full Backsplash Name (this is what prints out on the report)
Set, #SplashFLF$temp =16    ,FULL BACKSPLASH ------ lineal foot/meter cost
Set, #SplashFSQ$temp =0        ,FULL BACKSPLASH ------ Square foot/meter cost
,**
Set,#Subtotal13Name=Tile Backsplash ,Tile Backsplash Name (this is what prints out on the report)
Set, #SplashTLF$temp =20    ,TILE BACKSPLASH ------ lineal foot/meter cost
Set, #SplashTSQ$temp =0        ,TILE BACKSPLASH------- Square foot/meter cost


set, (#incm="-Inch"):#CTopLinealFactor=12
set, (#incm="-Inch"):#CtopSquareFactor=144
set, (#incm="-Mm"):#CTopLinealFactor=1000
set, (#incm="-Mm"):#CtopSquareFactor=1000000
set, (#incm="-Cm"):#CTopLinealFactor=100
set, (#incm="-Cm"):#CtopSquareFactor=10000



Set, #SplashTLF$ = #SplashTLF$temp/#CTopLinealFactor    ,TILE BACKSPLASH ------ lineal foot/meter cost
Set, #SplashTSQ$ = #SplashTSQ$temp/#CtopSquareFactor        ,TILE BACKSPLASH------- Square foot/meter cost
Set, #SplashFLF$ = #SplashFLF$temp/#CTopLinealFactor    ,FULL BACKSPLASH ------ lineal foot/meter cost
Set, #SplashFSQ$ = #SplashFSQ$temp/#CtopSquareFactor        ,FULL BACKSPLASH ------ Square foot/meter cost
Set, #Splash4LF$ = #Splash4LF$temp/#CTopLinealFactor  ,4" BACKSPLASH -------- lineal foot/meter cost
Set, #CTopLF$ = #CTopLF$temp/#CTopLinealFactor     ,* COUNTER TOP ---------- lineal foot cost
Set, #CTopSq$ = #CTopSq$temp/#CtopSquareFactor    ,* COUNTER TOP ---------- Square foot cost




