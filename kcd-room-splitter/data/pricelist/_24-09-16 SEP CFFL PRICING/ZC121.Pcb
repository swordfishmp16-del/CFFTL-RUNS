,CF Upper Blind Corner Right with Door
,Calculates the price for each part



,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, Pricesides.pcb       
,*****************************************



,********* All VERTICAL DIVIDERS *********
         
,*****************************************


,********* Blind Panel *********
Set, #VertH = [H]
Set, #VertD = [LE]
load, Priceblindpanels.pcb         
,*****************************************



,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
load, pricefixedshelves.pcb    
,*****************************************




,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set,#ShelfWidth = [(W-LS-RS)]
Set, #Tempshelfcount=SH
load, Priceadjshelves.pcb
,*****************************************

,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************


,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber, 
          
,Price, 1,            #ClosetPoleName,       #ClosetPoleCost,         (W-LS-RS), 1,  #ClosetPolePrintOrderNumber,        
,Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
,Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************






