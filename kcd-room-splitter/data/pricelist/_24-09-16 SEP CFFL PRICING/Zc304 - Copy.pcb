,CF Tall 4 drawer
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
Load, Pricesides.pcb
,*****************************************


,********* All VERTICAL DIVIDERS *********
,Vertical Divider
Set, #VertH = [DH1]
Set, #VertD = [D]
load, Pricedividers.pcb          
,*****************************************

Set,(D2T<>3)&(D3T<>3)&(D4T<>3)&(D5T=3):#lowerspannercount=2

Set,(D2T<>3)&(D3T<>3)&(D4T=3)&(D5T<>3):#lowerspannercount=2

Set,(D2T<>3)&(D3T=3)&(D4T<>3)&(D5T<>3):#lowerspannercount=2

Set,(D2T=3)&(D3T<>3)&(D4T<>3)&(D5T<>3):#lowerspannercount=2

Set,(D2T<>3)&(D3T<>3)&(D4T=3)&(D5T=3):#lowerspannercount=1
Set,(D2T<>3)&(D3T<>3)&(D4T=3)&(D5T=3)&(OPT=#optionLockdr4):#lowerspannercount=2

Set,(D2T<>3)&(D3T=3)&(D4T=3)&(D5T<>3):#lowerspannercount=2
Set,(D2T<>3)&(D3T=3)&(D4T=3)&(D5T<>3)&(OPT=#optionLockdr3):#lowerspannercount=2

Set,(D2T=3)&(D3T=3)&(D4T<>3)&(D5T<>3):#lowerspannercount=1
Set,(D2T=3)&(D3T=3)&(D4T<>3)&(D5T<>3)&(OPT=#optionLockdr2):#lowerspannercount=2

Set,(D2T<>3)&(D3T=3)&(D4T=3)&(D5T=3):#lowerspannercount=1
Set,(D2T<>3)&(D3T=3)&(D4T=3)&(D5T=3)&((OPT=#optionLockdr3)|(OPT=#optionLockdr4)):#lowerspannercount=1
Set,(D2T<>3)&(D3T=3)&(D4T=3)&(D5T=3)&((OPT=#optionLockdr3)&(OPT=#optionLockdr4)):#lowerspannercount=2

Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T<>3):#lowerspannercount=0
Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T<>3)&((OPT=#optionLockdr2)|(OPT=#optionLockdr3)):#lowerspannercount=1
Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T<>3)&((OPT=#optionLockdr2)&(OPT=#optionLockdr3)):#lowerspannercount=2

Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T=3):#lowerspannercount=0
Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T=3)&(((OPT=#optionLockdr2)&(OPT=#optionLockdr3))|((OPT=#optionLockdr3)&(OPT=#optionLockdr4))|((OPT=#optionLockdr2)&(OPT=#optionLockdr4))):#lowerspannercount=1
Set,(D2T=3)&(D3T=3)&(D4T=3)&(D5T=3)&((OPT=#optionLockdr2)&(OPT=#optionLockdr3)&(OPT=#optionLockdr4)):#lowerspannercount=2

Set,((D2H=0)&(D5H=0)):#lowerspannercount=1
Set,((D2H=0)&(D5H=0))&((D3T<>3)|(D4T<>3)):#lowerspannercount=2
Set,((D2H=0)&(D5H=0)&(OPT=#optionLockdr3)):#lowerspannercount=2


,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
set, #addmidshelf=1
Set, (LMR>0):#lowerspannercount = 2
load, Pricefixedshelves.pcb 
set, #addmidshelf=0       
,*****************************************


,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, (MS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-MS)/2]
Set, #ShelfDepth = [(D)]
Set, (MS=0):#tempshelfcount=SH1:#tempshelfcount=SH1*2 
Load, Priceadjshelves.pcb   
,*****************************************

,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************

,************* OTHER PARTS ***************
set, #Backheight = [DH1]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,              
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************








