,CF Base Cubby Holes
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
Load, Pricesides.pcb       
,*****************************************


,********* All VERTICAL DIVIDERS *********
         
,*****************************************

,*********** TOP SPANNERS OR FULL SHELF Base Cabinet **
Set, #ShelfWidth = [(W-LS-RS)] 
Set,(#FullTops="No"):#ShelfDepth=[#SpannerWidth]:#ShelfDepth=[D]    
,Load, Pricefixedshelves.pcb       
,*****************************************





,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, (MS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-MS)/2]
Set, (MS=0):#Tempshelfcount=SH:#Tempshelfcount=SH*2
,load, Priceadjshelves.pcb

,Lower Adj Shelves
Set, (LMS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-LMS)/2]
Set, (LMS=0):#Tempshelfcount=SH1:#Tempshelfcount=SH1*2
,Load, priceadjshelves.pcb   
,*****************************************




,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR-K]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber, 
           
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
,Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************




,************ All CUBBY HOLES ************
Set, #NumVertCubby = PT
Set, #NumHorzCubby = PN
Set, #CubbyHeight = DH1
Set, #CubbyWidth = (W-LS-RS)
Load, CubbyUnit.Pcb
,*****************************************

