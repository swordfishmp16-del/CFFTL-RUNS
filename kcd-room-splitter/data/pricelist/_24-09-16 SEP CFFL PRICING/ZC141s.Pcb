,CF  Upper w Dividers Below
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, Pricesides.pcb       
,*****************************************



,********* All VERTICAL DIVIDERS *********
,Vertical Divider
Set, #VertH = [DH1]
load, Pricedividers.pcb       
,*****************************************



,*********** All FIXED SHELVES ***********
,Done in cubbyunit.pcb below
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
,load, Pricefixedshelves.pcb       
,*****************************************




,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, (MS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-MS)/2]
Set, (MS=0):#Tempshelfcount=SH:#Tempshelfcount=SH*2
load, Priceadjshelves.pcb 
,*****************************************
,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************



,************* OTHER PARTS ***************
set, #Backheight = [H-TR-BR]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,               
,Price, 1,            #ClosetPoleName,       #ClosetPoleCost,         (W-LS-RS), 1,  #ClosetPolePrintOrderNumber,        
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
,Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************


,********** All CUBBY HOLES **************
Set, #NumVertCubby = NDIV+1
Set, #NumHorzCubby = 1
Set, #CubbyHeight = DH2
Set, #CubbyWidth = (W-LS-RS)
Load, CubbyUnit.Pcb
,*****************************************















