,CF Tall 5 drawer 
,Calculates the price for each part


,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [D]
load, Pricesides.pcb         
,*****************************************

,********* All VERTICAL DIVIDERS *********
,Vertical Divider
Set, #VertH = [DH1]
Set, #VertD = [D]
load, Pricedividers.pcb          
,*****************************************



set, #bottomdrw=5
load, lowerspannercount.pcb
set, #stopheretosee=1


,*********** All FIXED SHELVES ***********
Set, #ShelfWidth = [(W-LS-RS)]     
Set, #ShelfDepth = [(D)]
set, #addmidshelf=1
Set, (LMR>0):#lowerspannercount = 3
load, Pricefixedshelves.pcb 
set, #addmidshelf=0       
,*****************************************


,*********** All ADJ SHELVES *************
,Top Adj Shelves
Set, (MS=0):#ShelfWidth = [(W-LS-RS)]:#ShelfWidth = [(W-LS-RS-MS)/2]
Set, #ShelfDepth = [(D)]
Set, (MS=0):#tempshelfcount=SH1:#tempshelfcount=SH1*2 
Load, Priceadjshelves.pcb   
,*****************************************

,*********** RODS ***********      
set, #ShelfWidth = [(W-LS-RS)]
Load, Pricerods.pcb
,*****************************************


,************* OTHER PARTS ***************
set, #Backheight = [DH1]
set, #ShelfWidth = [(W-LS-RS)]
Price, (#IncludeBacks>0):1,   #BackName,             #CostOfBack,            #shelfwidth, #Backheight,          #BackPrintOrderNumber,               
Price, (K>0):1,      #KickName,             #CostOfKick,             w, K,          #KickPrintOrderNumber,              
,*****************************************




,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




,*********** All DRAWER BOXES ************
Load, Drawers.Pcb
,*****************************************




,************ All PULLOUTS ***************
Set, #PulloutOpeningWidth = [W-LS-RS]
,Load, (npo>0): G-Pullout Cost.Pcb
,*****************************************









