,CF Upper 45 shelf Right and Door with open sides angled with door
,Calculates the price for each part

,********** All VERTICAL SIDES ***********
Set, #VertH = [H]
Set, #VertD = [W-RS]
load, PriceCornersidesangleL.pcb 
,*****************************************



,*********** All SHELVES ***********
Set, #ShelfWidth = [(W-RS)]
Set, #ShelfDepth = [(D-LS)]
load, Pricecornershelves.pcb      
,*****************************************

,************* OTHER PARTS ***************            
Price, (K>0):1,    #KickName,               #CostOfKick,             (((W-RCCD)^2)+((D-LCCD)^2))^(1/2) , K,        #KickPrintOrderNumber,              
,*****************************************


,******* All DOORS & DRAWER FRONTS *******
Load, Doors.pcb
,*****************************************




