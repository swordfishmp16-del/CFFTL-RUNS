,This is a KCD system file. Do NOT change it in any way!

,This file will set the size of each Drawer Box and then load the file that makes the drawer boxes

,initialize these to zero before going into the E-Drawer Cost file
Set,#UnitDrawerCost=0
Set,#UnitDrawerNum=0


,Calculates a Drawer 1 cost
Set, #DrawerOpeningWidth = [W-LS-RS]
Set, #DrawerOpeningHeight = DH1
Set, #DrawerFrontWidth = D1W
Set, #DrawerFrontHeight = D1H
Set, (#DrawerFrontHeight=0):#drawerfront1=0:#drawerfront1=1
set, #nodrawerbox=0
Set, (D1DR>0):#drawernumber=1:#drawernumber=0
Set, ((Opt=#OptDrw1NDB)&(#drawernumber=1)):#nodrawerbox=1
set, #swapglides=0
Set, ((Opt=#OptDrw1SG)&(#drawernumber=1)&((#ExtraUnitText8 = "*under*")|(#ExtraUnitText8 = "*push*")|(#ExtraUnitText8 = "*inset*"))):#swapglides=1
Load, (#nodrawerbox=0)&(D1HG=0)&(D1H>0)&(D1T=3):E-Drawer Cost.Pcb
,Load, (D1H>0)&(DH1>0)&(D1T=3):E-Drawer Cost.Pcb

,Calculates a Drawer 2 cost
Set, #DrawerOpeningWidth = [W-LS-RS]
Set, #DrawerOpeningHeight = DH2
