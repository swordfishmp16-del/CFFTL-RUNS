,****************************************************    TAX AND INSTALLATION CHARGES   ********************************************************
,Update V7.2.5 start
DisplaySet,#UseTax=No, ------------------- Do you charge tax? [Yes;No]
Do,(#UseTax="Yes")|(#DisplayEdit):1
{
,   DisplaySet,#Sub21Name=Tax 5 Percent, ---------------------- Name on printed report for tax
,   DisplaySet,#TaxAmt=0.05, ---------------------- Percent to charge for tax
   Set,#Sub21Name=#Taxlevel, ---------------------- Name on printed report for tax
   Set,#TaxAmt=#Taxamount, ---------------------- Percent to charge for tax
   
}
,Update V7.2.5 end
DisplaySet,#UseInstallation=No, --------------------- Do charge for installation?[Yes;No]
Do,(#UseInstallation="Yes")|(#DisplayEdit):1
{
   DisplaySet,#Sub20Name=Installation, ----------------------- Name on printed report for installation charge
   DisplaySet,#InstallationTax=Yes, -------------------------- Is your installation charge taxable? (set to yes if you do not charge tax)[Yes;No]
   DisplaySET,#InstallationNumOfUnits=Total Number of Units,  Choose the total you want to calculate from[Total Number of Units;Total Number of Cabinets/Closets;Total Number of Panels]
   DisplaySET,#InstallationCostNumOfUnits=10, Amount to charge (amount to multiply for the above total)
   
   DisplaySET,#InstallationMeasurement=Lineal Footage of All Units,Choose the length you want to calculate from[Lineal Footage of All Units;Square Footage of All Units;Cubic Footage of All Units;Lineal Footage of All Cabinets/Closets;Square Footage of All Cabinets/Closets;Cubic Footage of All Cabinets/Closets]
   DisplaySET,#InstallationMeasurementCost=0,Amount to charge(amount to multiply for the above length)
}

,Update V7.2.5 start
Do,(#UseTax="Yes")|(#DisplayEdit):1
{
,************************************************************ TAX POP-UP ***********************************************************************
,**
,**   TAX See Tax question above
,**   This section will help you create a pop-up Question when running your pricing. Create a choice of tax levels you wish below .05 is 5% 

DisplaySet,#HowManyTaxlevels=0,1.1  How many Tax categories would you like? 0 shuts taxes pop-up off? Use if tax % VARY BY LOCATION or if NOT APPLIED TO ALL JOBS. [0;1;2;3;4;5]
Do,((#HowManyTaxlevels=0)&(#UseTax="Yes"))|(#DisplayEdit):1
{
   DisplaySet,#Taxlevel=Tax 5 Percent, ---------------------- Name on printed report for tax
   DisplaySet,#Taxamount=0.05, ---------------------- Percent to charge for tax if SAME ON ALL JOBS
}   
}
,**
Skip,(#HowManyTaxlevels=0):1
{
   DisplaySet, #TaxlevelName =Apply Sales Tax?,1.2 --- Customer Tax Question? This will be the pop-question when running pricing
   
   ,**
   Do,(#HowManyTaxlevels=1):1
   {
      DisplaySet,#TaxName1=No Tax,1.3 Name of Tax Level 1
      AskQuestion,#TaxLevel,#TaxName1,#TaxlevelName [#TaxName1]
      DisplaySet,#TaxLevel1=0.00,1.8   (Tax Level 1) #TaxName1 percentage
   }
   
   Do,(#HowManyTaxlevels=2):1
   {
      DisplaySet,#TaxName1=No Tax,1.3 Name of Tax Level 1
      DisplaySet,#TaxName2=County Tax 3 %,1.4 Name of Tax Level 2
      AskQuestion,#TaxLevel,#TaxName1,#TaxlevelName [#TaxName1,#TaxName2]
      DisplaySet,#TaxLevel1=0.00,1.8   (Tax Level 1) #TaxName1 percentage
      DisplaySet,#TaxLevel2=0.03,1.9   (Tax Level 2) #TaxName2 percentage
   }
   
   Do,(#HowManyTaxlevels=3):1
   {
      DisplaySet,#TaxName1=No Tax,1.3 Name of Tax Level 1
      DisplaySet,#TaxName2=County Tax 3 %,1.4 Name of Tax Level 2
      DisplaySet,#TaxName3=County Tax  5 %,1.5 Name of Tax Level 3
      AskQuestion,#TaxLevel,#TaxName1,#TaxlevelName [#TaxName1;#TaxName2;#TaxName3]
      DisplaySet,#TaxLevel1=0.00,1.8   (Tax Level 1) #TaxName1 percentage
      DisplaySet,#TaxLevel2=0.03,1.9   (Tax Level 2) #TaxName2 percentage
      DisplaySet,#TaxLevel3=0.05,1.10   (Tax Level 3) #TaxName3 percentage
   }
   
   Do,(#HowManyTaxlevels=4):1
   {
      DisplaySet,#TaxName1=No Tax,1.3 Name of Tax Level 1
      DisplaySet,#TaxName2=County Tax 6.5%,1.4 Name of Tax Level 2
      DisplaySet,#TaxName3=County Tax  7.0%,1.5 Name of Tax Level 3
      DisplaySet,#TaxName4=County Tax  7.5%,1.6 Name of Tax Level 4
      AskQuestion,#TaxLevel,#TaxName1,#TaxlevelName [#TaxName1;#TaxName2;#TaxName3;#TaxName4]
      DisplaySet,#TaxLevel1=0.00,1.8   (Tax Level 1) #TaxName1 percentage
      DisplaySet,#TaxLevel2=0.065,1.9   (Tax Level 2) #TaxName2 percentage
      DisplaySet,#TaxLevel3=0.070,1.10   (Tax Level 3) #TaxName3 percentage
      DisplaySet,#TaxLevel4=0.075,1.11   (Tax Level 4) #TaxName4 percentage
   }
   
   Do,(#HowManyTaxlevels=5):1
   {
      DisplaySet,#TaxName1=No Tax,1.3 Name of Tax Level 1
      DisplaySet,#TaxName2=County Tax 3 %,1.4 Name of Tax Level 2
      DisplaySet,#TaxName3=County Tax  5 %,1.5 Name of Tax Level 3
      DisplaySet,#TaxName4=County Tax  8 %,1.6 Name of Tax Level 4
      DisplaySet,#TaxName5=County Tax  10 %,1.7 Name of Tax Level 5
      AskQuestion,#TaxLevel,#TaxName1,#TaxlevelName [#TaxName1;#TaxName2;#TaxName3;#TaxName4;#TaxName5]
      DisplaySet,#TaxLevel1=0.00,1.8   (Tax Level 1) #TaxName1 percentage
      DisplaySet,#TaxLevel2=0.03,1.9   (Tax Level 2) #TaxName2 percentage
      DisplaySet,#TaxLevel3=0.05,1.10   (Tax Level 3) #TaxName3 percentage
      DisplaySet,#TaxLevel4=0.08,1.11   (Tax Level 4) #TaxName4 percentage
      DisplaySet,#TaxLevel5=0.10,1.12   (Tax Level 5) #TaxName5 percentage
   }
   
   Set,(#TaxLevel="#TaxName1"):#Taxamount=#TaxLevel1
   Set,(#TaxLevel="#TaxName2"):#Taxamount=#TaxLevel2
   Set,(#TaxLevel="#TaxName3"):#Taxamount=#TaxLevel3
   Set,(#TaxLevel="#TaxName4"):#Taxamount=#TaxLevel4
   Set,(#TaxLevel="#TaxName5"):#Taxamount=#TaxLevel5
   
   Set,(#TaxLevel="#TaxName1"):#TaxName=#TaxName1
   Set,(#TaxLevel="#TaxName2"):#TaxName=#TaxName2
   Set,(#TaxLevel="#TaxName3"):#TaxName=#TaxName3
   Set,(#TaxLevel="#TaxName4"):#TaxName=#TaxName4
   Set,(#TaxLevel="#TaxName5"):#TaxName=#TaxName5
}

,Update V7.2.5 end
